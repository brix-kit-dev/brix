{
  "name": "@brix-sdk/runtime-sdk-api-mobile",
  "version": "3.2.0",
  "description": "Brix Runtime SDK API - React Native Mobile Platform capability contracts",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-platform/runtime-sdk.git",
    "directory": "runtime-sdk-api-mobile"
  },
  "publishConfig": {
    "access": "public"
  }
}
