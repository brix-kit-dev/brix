<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>io.brix</groupId>
        <artifactId>runtime-sdk-parent</artifactId>
        <version>3.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    
    <artifactId>runtime-orchestrator</artifactId>
    <name>Brix Runtime Orchestrator</name>
    <description>
        Runtime orchestration engine responsible for module registration, lifecycle management,
        and event dispatching. The Host layer uses this module to manage and coordinate all
        module operations.
    </description>
    
    <dependencies>
        <!-- Runtime SDK API (contains contract interfaces and convenience wrappers) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>
        
        <!-- Runtime Manifest (used by ManifestDrivenEventDispatcher and capability validation) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-manifest</artifactId>
        </dependency>
        
        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
          Spring Boot AutoConfigure (optional dependency)
          
          Provides auto-configuration support for CapabilityAutoConfiguration.
          Set to optional=true so Spring Boot is not forcefully included.
          If consumers do not need auto-configuration, they can skip Spring Boot.
          
          v3.0.4 architecture guardrail fix: extracted capability scanning logic from Host layer to orchestration layer
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Spring Boot Actuator (optional dependency)

          Used only when a Spring Boot Host includes actuator and wants
          Runtime Shell readiness to contribute to the readiness health group.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        
        <!--
          Spring Web (optional dependency)
          
          Used by PluginRegistryEndpoint to expose the /api/plugins REST endpoint.
          Set to optional=true; only activated when the Host includes spring-boot-starter-web.
          
          v3.0.5 plugin dynamic discovery: reads registered modules from ModuleRegistry and exposes them to the frontend
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring transaction synchronization for durable command receipts. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <version>6.1.3</version>
            <optional>true</optional>
        </dependency>

        <!-- Servlet API for the Spring Web Runtime Shell endpoint bridge. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <optional>true</optional>
        </dependency>
        
        <!-- Jakarta Annotation API (for @PostConstruct) -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
            <optional>true</optional>
        </dependency>
        
        <!-- Jackson (for UI Manifest JSON parsing) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.3</version>
            <optional>true</optional>
        </dependency>

        <!--
          JSON Schema Validator (for plugin-manifest.json fail-fast validation, P0-2 / R3.7)

          Used by UIManifestLoader to validate every classpath plugin-manifest.json
          against the bundled META-INF/schemas/plugin-manifest.schema.json at startup.
          NOT optional: UIManifestLoader hard-depends on this validator to honour the
          fail-fast contract; making it optional would silently degrade validation in
          consumer Hosts that forget to pull it.
        -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.6</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
