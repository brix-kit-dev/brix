{
  "name": "@brix/runtime-manifest-web",
  "version": "1.0.0",
  "description": "UI 运行时清单解析和验证模块",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brix/runtime-sdk-api-web": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "brix",
    "runtime",
    "manifest",
    "plugin",
    "ui"
  ],
  "license": "Apache-2.0"
}
