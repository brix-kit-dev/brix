{
  "name": "@brix-sdk/runtime-sdk-react",
  "version": "3.2.0",
  "description": "Brix Runtime SDK React Bindings - React Context and Hooks bindings",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@brix-sdk/runtime-sdk-api-web": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.0",
    "@types/react": "^18.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@brix-sdk/shared-runtime-web": "workspace:*",
    "react": "^18.2.0"
  },
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-platform/runtime-sdk.git",
    "directory": "runtime-sdk-react"
  },
  "publishConfig": {
    "access": "public"
  }
}





