<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix</groupId>
        <artifactId>runtime-sdk-parent</artifactId>
        <version>3.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>runtime-sdk-api</artifactId>
    <packaging>jar</packaging>

    <name>Brix Runtime SDK API</name>
    <description>
        运行壳能力契约接口定义与开发支持
        
        本模块定义了模块与 Runtime Shell 之间的所有契约接口，包括：
        - 核心能力接口（EventBus、StateStore、AuthContext 等）
        - 事件基类（DomainEvent、IntegrationEvent）
        - 运行时上下文（RuntimeContext）
        - Host 抽象接口
        - 模块注解（@Module、@EventHandler）
        - 便利包装类（AbstractModule、ModuleState）
        
        【设计原则】
        - 本模块为契约定义层，不包含任何基础设施实现
        - 模块（Plugin）只需依赖此模块
        - 便利包装类（support 包）仅封装 RuntimeContext 调用，不是能力实现
        - 禁止引入 Kafka/Redis/MySQL 等基础设施依赖
    </description>

    <dependencies>
        <!-- 日志门面：仅用于 ObservabilityCapability 的日志级别枚举 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
