{
  "name": "@brix-sdk/platform-commons",
  "version": "3.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Brix Platform Commons - Platform-level shared capabilities (unified frontend/backend repository)",
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-platform/platform-commons.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter \"./platform-*-web\" build",
    "build:mobile": "pnpm --filter \"./platform-*-mobile\" build",
    "build:shared": "pnpm --filter \"./platform-shared\" build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && pnpm changeset:publish",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@changesets/changelog-github": "^0.5.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "tsup": "^8.0.1",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^3.17.1",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
