{
  "name": "@brix-sdk/platform-frame-web",
  "version": "3.2.0",
  "description": "Brix Platform Frame Web - Layout, theme, and page capabilities for the runtime shell (Layer 2C)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pages": {
      "import": "./dist/pages/index.js",
      "types": "./dist/pages/index.d.ts"
    },
    "./layouts": {
      "import": "./dist/layouts/index.js",
      "types": "./dist/layouts/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n/index.js",
      "types": "./dist/i18n/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brix-sdk/runtime-sdk-api-web": "workspace:*",
    "@brix-sdk/runtime-sdk-react": "workspace:*",
    "@brix-sdk/platform-design-tokens": "workspace:*",
    "@brix-sdk/platform-auth-web": "workspace:*",
    "@brix-sdk/platform-navigation-web": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "react": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicx-next/brix.git",
    "directory": "packages/@brix/platform-commons/packages/client/platform-frame-web"
  },
  "keywords": [
    "brix",
    "platform",
    "frame",
    "layout",
    "theme",
    "shell",
    "web"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "sideEffects": false
}
