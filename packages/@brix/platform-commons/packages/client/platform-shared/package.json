{
  "name": "@brix/platform-shared",
  "version": "1.0.0",
  "description": "Platform Shared Module - Cross-platform shared types, constants and utility functions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./id": {
      "import": "./dist/id/index.js",
      "types": "./dist/id/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "types": "./dist/http/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brix/infra-adapter-http-web": "link:../../../../infra-adapters/packages/web/infra-adapter-http-web",
    "@brix/runtime-sdk-api-web": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "brix",
    "platform",
    "shared",
    "types",
    "utils",
    "id",
    "http"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0"
}
