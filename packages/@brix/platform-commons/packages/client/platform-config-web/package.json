{
  "name": "@brix/platform-config-web",
  "version": "1.0.0",
  "description": "Web Configuration Capability Implementation - Implements ConfigCapability Interface",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@brix/runtime-sdk-api-web": "workspace:*"
  },
  "peerDependencies": {
    "@brix/runtime-sdk-api-web": "^3.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.2.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "brix",
    "platform",
    "config",
    "capability",
    "configuration"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "sideEffects": false
}
