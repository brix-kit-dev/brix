{
  "name": "@brix-sdk/platform-tenant-web",
  "version": "3.2.0",
  "description": "Tenant web plugin contract for FIRST_OWNER activation and manifest-backed route assembly",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@brix-sdk/runtime-sdk-api-web": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@brix-sdk/runtime-sdk-api-web": "workspace:*",
    "@brix-sdk/runtime-sdk-react": "workspace:*"
  },
  "devDependencies": {
    "@brix-sdk/eslint-config-architecture": "workspace:*",
    "@brix-sdk/runtime-sdk-react": "workspace:*",
    "@testing-library/react": "^14.1.0",
    "@types/react": "^18.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "react": "^18.2.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "typescript-eslint": "^7.18.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "brix",
    "platform",
    "tenant",
    "first-owner",
    "activation",
    "runtime-shell"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0"
}
