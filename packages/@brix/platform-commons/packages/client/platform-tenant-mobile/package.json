{
  "name": "@brix-sdk/platform-tenant-mobile",
  "version": "3.2.0",
  "description": "Mobile Tenant Capability Implementation - Multi-tenant context, secure token storage, push notification tenant routing for React Native",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@brix-sdk/runtime-sdk-api-mobile": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-native": ">=0.72.0",
    "@brix-sdk/runtime-sdk-api-mobile": "workspace:*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": false
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "^18.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "brix",
    "platform",
    "tenant",
    "multi-tenant",
    "mobile",
    "react-native",
    "capability",
    "secure-storage"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0"
}
