{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@brix-sdk/runtime-sdk-api-web": ["../../../../runtime-sdk/runtime-sdk-api-web/src"],
      "@brix-sdk/runtime-sdk-api-web/*": ["../../../../runtime-sdk/runtime-sdk-api-web/src/*"],
      "@brix-sdk/runtime-sdk-react": ["../../../../runtime-sdk/runtime-sdk-react/src"],
      "@brix-sdk/runtime-sdk-react/*": ["../../../../runtime-sdk/runtime-sdk-react/src/*"],
      "@brix-sdk/platform-auth-web": ["../platform-auth-web/src"],
      "@brix-sdk/platform-auth-web/*": ["../platform-auth-web/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
