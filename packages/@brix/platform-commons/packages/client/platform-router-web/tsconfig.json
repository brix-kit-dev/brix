{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@brix/runtime-sdk-api-web": ["../../runtime-sdk/runtime-sdk-api-web/src"],
      "@brix/runtime-sdk-api-web/*": ["../../runtime-sdk/runtime-sdk-api-web/src/*"],
      "@brix/runtime-sdk-shared": ["../../runtime-sdk/runtime-sdk-shared/src"],
      "@brix/runtime-sdk-shared/*": ["../../runtime-sdk/runtime-sdk-shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
