{
  "name": "@brix-sdk/platform-eventbus-web",
  "version": "3.2.0",
  "description": "Web EventBus capability implementation - implements GovernedEventBusCapability interface",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@brix-sdk/runtime-sdk-api-web": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.2.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "brix",
    "platform",
    "eventbus",
    "capability"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-platform/platform-commons.git",
    "directory": "packages/client/platform-eventbus-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
