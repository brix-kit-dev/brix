{
  "name": "@brix/platform-auth-web",
  "version": "1.0.0",
  "description": "Web Auth Capability Implementation - Implements AuthCapability interface and auth components",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.mjs",
      "require": "./dist/pages.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@brix/runtime-sdk-api-web": "workspace:*",
    "@brix/platform-auth-service-web": "^3.1.0",
    "@brix/platform-auth-ui-web": "^3.1.0"
  },
  "peerDependencies": {
    "@brix/shared-runtime-web": "^1.0.0",
    "react": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "react": "^18.2.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "brix",
    "platform",
    "auth",
    "capability"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "sideEffects": false
}
