<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================================
    Platform Tenant - Multi-Tenancy Core Module
    ============================================================================
    
    【Module Description / 模块说明】
    This module provides the core multi-tenancy infrastructure for Brix Platform,
    implementing row-level tenant isolation with comprehensive security features.
    
    【Architecture Layer / 架构层次】
    Layer 2C: Implementation Layer (能力实现层)
    - Belongs to platform-commons, provides tenant isolation capabilities
    - Implements tenant context, entity base classes, and data validation
    
    【Key Features / 核心功能】
    - TenantContext: Thread-local tenant context management
    - TenantOwnedEntity: Base class for tenant-scoped entities with ownership
    - ID Generation: Snowflake-based distributed ID generator
    - Reference Validation: Cross-tenant reference integrity checks
    - SQL Guard: Runtime SQL inspection for tenant isolation enforcement
    
    【Design Constraints / 设计约束】
    1. All business tables MUST include tenant_id column
    2. All queries MUST include tenant filter conditions
    3. Cross-tenant access MUST be explicitly annotated
    4. Audit logging for all sensitive operations
    
    【Package Structure / 包结构】
    io.brix.platform.tenant
    ├── core/           → Core utilities (IdGenerator, TenantWhitelist)
    ├── enums/          → Frozen enums (TenantStatus, MemberType, etc.)
    ├── entity/         → JPA entities with tenant ownership
    ├── repository/     → Spring Data JPA repositories
    ├── service/        → Tenant provisioning services
    ├── validation/     → Reference consistency validators
    ├── resolver/       → Tenant resolution strategies (JWT, Header, etc.)
    ├── interceptor/    → MyBatis interceptors for auto-filtering
    ├── filter/         → Servlet filters for context initialization
    ├── decorator/      → Task decorators for async propagation
    ├── exception/      → Tenant-specific exceptions
    └── config/         → Auto-configuration classes
    
    【Version History / 版本历史】
    - v3.2.0: Initial multi-tenant MVP implementation
    
    ============================================================================
    -->

    <parent>
        <groupId>io.brix.platform</groupId>
        <artifactId>platform-commons</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>platform-tenant</artifactId>
    <name>platform-tenant</name>
    <description>Brix Platform Multi-Tenancy Core Module - Row-level isolation with ownership model</description>

    <dependencies>
        <!--
        ========== Spring Boot Dependencies ==========
        Core Spring Boot starters for web, data, and validation
        -->
        
        <!-- Spring Boot Web Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- Spring Boot Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
        ========== Database Dependencies ==========
        PostgreSQL driver and Flyway for migrations
        -->
        
        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <!-- Flyway Database Migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
        ========== Internal Dependencies ==========
        Platform common utilities (TenantContext is in platform-common)
        -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runtime SDK Capability Contract (TenantCapability interface) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
            <version>3.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-manifest</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!--
        Platform Auth (optional) — used by TenantCapabilityImpl to delegate
        getCurrentRole/isActor/isSubject to SecurityContextHolder.
        Both modules are Layer 2C in platform-commons; this is a legal same-layer dependency.
        -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-auth</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!--
        ========== Utility Dependencies ==========
        -->
        
        <!-- Lombok for boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
        ========== Test Dependencies ==========
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- H2 Database for testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Architecture Guard for architecture compliance tests -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            
            <!-- Surefire Plugin for tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
