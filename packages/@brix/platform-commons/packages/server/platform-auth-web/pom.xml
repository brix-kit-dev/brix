<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================================
    Platform Auth Web — REST Controller layer over AuthFlowCapability
    ============================================================================

    [D3 Refactoring — v3.2.0]
    Hosts the canonical REST surface for platform authentication flows:
      - AuthController            → consumes AuthFlowCapability
      - OAuth2FederationController → consumes OAuth2FederationCapability (ID-Token)
      - LoginResultMapper          → LoginResult (capability) → LoginResponseDto (HTTP)
      - AuthFlowExceptionAdvice    → AuthFlowException → HTTP status + error code

    [Architecture Layer]
    Layer 2C (Servlet runtime binding). Pure delegation to Layer 2A capabilities;
    no business logic resides here.

    [What this module does NOT do]
    - OAuth2 Authorization-Code Flow (authorize URL, callback redirect, state) —
      remains in identity-server's legacy OAuth2Controller until an
      OAuth2AuthorizationCodeCapability is introduced.
    - JWT validation / SecurityContext filter — that lives in platform-auth-servlet.
    ============================================================================
    -->

    <parent>
        <groupId>io.brix.platform</groupId>
        <artifactId>platform-commons</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>platform-auth-web</artifactId>
    <packaging>jar</packaging>

    <name>Platform Auth Web</name>
    <description>REST controllers + DTOs over AuthFlowCapability and OAuth2FederationCapability.</description>

    <dependencies>
        <!-- platform-auth core (AuthFlowException codes, JwtProperties for OpenAPI examples) -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-auth</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- runtime-sdk-api: AuthFlowCapability, OAuth2FederationCapability contracts -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- Spring Web (Servlet) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- OpenAPI v3 annotations (springdoc) — annotations only, no runtime processor here -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>2.2.50</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
