<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    Platform audit Data Owner, plugin-server artifact (root BRX-RS-MANIFEST-005/008): the plugin
    entry, the Runtime descriptor, the internal contract provider, the owner's assembly and its
    Flyway migrations (db/migration/platform-audit).
    -->
    <parent>
        <groupId>io.brix.platform</groupId>
        <artifactId>platform-commons</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../../pom.xml</relativePath>
    </parent>

    <artifactId>platform-audit-server</artifactId>
    <name>platform-audit-server</name>
    <description>Platform audit Data Owner: plugin entry, descriptor, contract provider and migrations</description>

    <dependencies>
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-audit-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
            <version>3.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-manifest</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
        <!-- The identity audit fact chain through the runtime's in-process delivery (P4 design §4.2) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-orchestrator</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Migration test on the reference DCP (root DATA-046); runs when BRIX_P0_POSTGRES_URL is set -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
