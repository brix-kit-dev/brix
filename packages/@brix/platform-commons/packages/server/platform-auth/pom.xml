<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================================
    Platform Auth (Core) — Authentication & Authorization API
    ============================================================================

    [D7 Refactoring — Solution B: Multi-runtime Support]
    Extracted from the original monolithic platform-auth module that mixed
    Servlet and WebFlux dependencies. Now split into three modules:

      platform-auth           (this) — Pure API: JWT validation, permission
                               annotations, SecurityContext, domain exceptions.
                               Zero runtime-model dependency (no Servlet, no WebFlux).
      platform-auth-servlet   — Servlet Filter implementation + AutoConfiguration.
                               Used by synchronous Spring MVC hosts.
      platform-auth-reactive  — OAuth2 WebFlux controllers, WebClient, ReactiveRedis.
                               Used by reactive/gateway hosts or standalone OAuth2 flows.

    [Architecture Layer]
    Layer 2A: Capability Contract (pure interfaces and domain types).
    Both platform-auth-servlet and platform-auth-reactive depend on this
    core module and provide their own runtime bindings.

    [Open-source License]
    Apache License 2.0
    ============================================================================
    -->

    <parent>
        <groupId>io.brix.platform</groupId>
        <artifactId>platform-commons</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>platform-auth</artifactId>
    <packaging>jar</packaging>

    <name>Platform Auth (Core)</name>
    <description>Authentication and authorization core — JWT validation, permission annotations, SecurityContext. Runtime-model agnostic.</description>

    <dependencies>
        <!-- Runtime SDK API (for PasswordCapability contract) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Spring Security Crypto (for BCryptPasswordEncoder) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot AOP (for permission aspects) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Boot Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Context (for @ConfigurationProperties, ResourceLoader) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>

        <!-- JJWT for JWT parsing -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson Databind: required by JwtIssuerCapability impl
             (safe JSON serialization to prevent claim injection) and
             OAuth2 federation impl (Google JWKS / ID Token parsing). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Spring Data JPA (A2: RefreshToken entity persistence) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
