{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brix://schemas/platform-admin/create-platform-tenant-request/1.0.0",
  "title": "Create a pending tenant",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name"],
  "properties": {
    "code": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" }
  }
}
