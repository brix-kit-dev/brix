<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================================
    Platform Admin — 平台运维模块
    ============================================================================

    【模块说明 / Module Description】
    本模块实现 v3.0.10 运行壳基线下的 platform-admin operational entry：
    通过 ServiceLoader<PlatformOperationalModule> 和 platform-operational.yaml
    声明平台运维入口，业务事实写入只经 Data Owner internal contract。

    【架构层次 / Architecture Layer】
    Layer 2B: Platform Operational Module（平台运维面，无租户上下文）

    【架构红线 / Architectural Red Lines (SSOT §11)】
    R-1: 本模块绝对禁止依赖任何 enterprise-* 模块。
    R-2: enterprise-solutions 绝对禁止将本模块加入依赖。
    R-3: 所有端点必须由 platform-operational.yaml 声明具体 permission policy。
    R-12: API 响应绝对禁止携带明文密码、setup token、setup URL 或 MFA secret。

    【Route Prefix / 路由前缀】
    所有端点统一使用 /api/platform/** 前缀，与租户业务路由隔离。

    【Runtime Entry】
    META-INF/services/io.runtime.orchestrator.operational.PlatformOperationalModule
    → io.brix.platform.admin.operational.PlatformAdminOperationalModule

    ============================================================================
    -->

    <parent>
        <groupId>io.brix.platform</groupId>
        <artifactId>platform-commons</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>platform-admin</artifactId>
    <name>Platform Admin</name>
    <description>平台超级管理员服务 — setup/TOTP、超管授权、租户视图、审计、RBAC</description>

    <dependencies>

        <!-- ================================================================
             Platform Internal Dependencies
             ================================================================ -->

        <!--
            platform-tenant: current repository-local home of the
            TenantAdministration internal contract API. platform-admin main
            code may import only io.brix.platform.tenant.internal.*.
        -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-tenant</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runtime SDK API: EndpointInvocation and BrixHealth contracts. -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Runtime Orchestrator: L2B operational SPI. -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-orchestrator</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- DTO validation annotations. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Jackson annotations and DTO tests. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ================================================================
             Test
             ================================================================ -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
