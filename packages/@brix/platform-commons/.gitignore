# ============================================================
# platform-commons .gitignore
# Java / Maven + Node.js / pnpm Hybrid Project
# ============================================================

# ---------------------- Java / Maven ----------------------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# ---------------------- Node.js / pnpm -------------------
node_modules/
dist/
.pnpm-debug.log
*.tsbuildinfo

# ---------------------- IDE ------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.project
.classpath
.settings/
*.swp
*.swo
*~
.LCK*

# ---------------------- OS -------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------- Environment & Secrets -----------------------
# [Critical] Phase 0 Security Hardening: all secret files must be ignored
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks
*.keystore
*client_secret*.json
private.pem
cert.pem
jwt-keystore.p12

# ---------------------- Build Artifacts & Residuals --------------------
# [Critical] Phase 0 Requirement: ignore compiled artifacts and temp files
jar-temp/
tsup.config.bundled_*.mjs

# ---------------------- Logs & Temp Files --------------------
*.log
*.tmp
*.bak
hs_err_pid*
