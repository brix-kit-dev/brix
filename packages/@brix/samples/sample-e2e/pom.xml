<!--
  Runs sample-orders and sample-shipping through the plugin runtime on PostgreSQL and Kafka (Kafka design §14.5
  item 3). The host is only auto-configurations and properties: no host code, and no messaging DDL in the plugins.
  The test needs a throwaway PostgreSQL: BRIX_P0_POSTGRES_URL, _USER and _PASSWORD; without them it is skipped.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.samples</groupId>
        <artifactId>brix-samples</artifactId>
        <version>3.2.0</version>
    </parent>

    <artifactId>sample-e2e</artifactId>
    <name>Brix Sample - End to end</name>
    <description>The sample plugins on PostgreSQL and Kafka through the plugin runtime</description>

    <dependencies>
        <!-- The plugins, as a host composes them -->
        <dependency>
            <groupId>io.brix.samples</groupId>
            <artifactId>sample-orders</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix.samples</groupId>
            <artifactId>sample-shipping</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The runtime and the adapters a host on PostgreSQL and Kafka selects -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-orchestrator</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-database</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-persistence-jpa</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-outbox</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-kafka-core</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-idgen</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
