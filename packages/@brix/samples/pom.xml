<!--
============================================================================
Brix Samples - plugins that show the standard event chain (Kafka design §14 K23)
============================================================================
  sample-orders    publisher: an HTTP endpoint places an order, which publishes
                   SampleOrderPlaced (STANDARD, outbox) and SampleOrderActivity
                   (BEST_EFFORT) with JSON schemas and its own migration
  sample-shipping  subscriber: prepares a shipment for each order, deduplicated
                   by the runtime's persistent inbox, and shows it over HTTP
  Each plugin is three artifacts, -api, -core and -server (root BRX-RS-MANIFEST-005).
  sample-e2e       runs both through the plugin runtime on PostgreSQL and
                   Kafka, with no host code and no messaging DDL in the plugins
============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.brix.samples</groupId>
    <artifactId>brix-samples</artifactId>
    <version>3.2.0</version>
    <packaging>pom</packaging>
    <name>Brix Samples</name>
    <description>Sample plugins of the standard event chain</description>

    <modules>
        <module>sample-orders-api</module>
        <module>sample-orders-core</module>
        <module>sample-orders-server</module>
        <module>sample-shipping-api</module>
        <module>sample-shipping-core</module>
        <module>sample-shipping-server</module>
        <module>sample-e2e</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
        <brix.version>3.2.0</brix.version>
        <maven-compiler-plugin.version>3.12.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <!-- Samples are examples, never published -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
