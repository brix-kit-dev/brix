<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.samples</groupId>
        <artifactId>brix-samples</artifactId>
        <version>3.2.0</version>
    </parent>

    <artifactId>sample-orders-api</artifactId>
    <name>Brix Sample - Orders API (plugin-api)</name>
    <description>What sample-orders publishes: event payloads, its HTTP contract, its typed command and their JSON schemas; no implementation and no framework</description>

    <dependencies>
        <!-- The generated command contract types carry @ContractSchema and their CommandType constants (plan L4.1) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
            <version>${brix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ContractSourcesTest fails when the checked-in contract sources are not what the schemas generate -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-contract-generator</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
