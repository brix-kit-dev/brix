<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.samples</groupId>
        <artifactId>brix-samples</artifactId>
        <version>3.2.0</version>
    </parent>

    <artifactId>sample-orders-server</artifactId>
    <name>Brix Sample - Orders server (plugin-server)</name>
    <description>The plugin entry point, the HTTP endpoint handler, the manifest and the migration</description>

    <dependencies>
        <dependency>
            <groupId>io.brix.samples</groupId>
            <artifactId>sample-orders-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The contract of the sample-shipping query the order detail calls: its api artifact only (root LIFE-010) -->
        <dependency>
            <groupId>io.brix.samples</groupId>
            <artifactId>sample-shipping-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
            <version>${brix.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- EventSchemaContract checks the published payloads against their schemas at build time (D24) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-orchestrator</artifactId>
            <version>${brix.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-orchestrator</artifactId>
            <version>${brix.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The architecture guard's plugin rules run on this module (standard-link plan §11 point 1) -->
