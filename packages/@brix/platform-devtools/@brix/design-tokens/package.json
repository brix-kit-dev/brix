{
  "name": "@brix/design-tokens",
  "version": "3.1.0",
  "description": "Brix Platform 设计令牌（颜色、间距、字体）",
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean && npm run build:css",
    "build:css": "node scripts/generate-css.js",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "brix",
    "platform",
    "design-tokens",
    "theme",
    "colors",
    "spacing",
    "typography"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-platform/platform-devtools.git",
    "directory": "@brix/design-tokens"
  },
  "publishConfig": {
    "access": "public"
  }
}
