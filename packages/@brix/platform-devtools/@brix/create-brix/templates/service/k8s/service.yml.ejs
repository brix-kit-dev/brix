apiVersion: v1
kind: Service
metadata:
  name: <%= serviceName %>
  namespace: <%= namespace || 'default' %>
  labels:
    app: <%= serviceName %>
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 80
      targetPort: 8080
      protocol: TCP
  selector:
    app: <%= serviceName %>
---
<% if (enableIngress) { %>
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: <%= serviceName %>-ingress
  namespace: <%= namespace || 'default' %>
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - <%= host || serviceName + '.brix.io' %>
      secretName: <%= serviceName %>-tls
  rules:
    - host: <%= host || serviceName + '.brix.io' %>
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: <%= serviceName %>
                port:
                  number: 80
<% } %>
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: <%= serviceName %>-hpa
  namespace: <%= namespace || 'default' %>
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: <%= serviceName %>
  minReplicas: <%= minReplicas || 1 %>
  maxReplicas: <%= maxReplicas || 5 %>
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 80
