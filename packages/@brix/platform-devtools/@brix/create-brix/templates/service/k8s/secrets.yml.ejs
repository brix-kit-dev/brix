apiVersion: v1
kind: Secret
metadata:
  name: <%= serviceName %>-secrets
  namespace: <%= namespace || 'default' %>
type: Opaque
stringData:
  # 数据库凭证（生产环境应使用 External Secrets）
  SPRING_DATASOURCE_USERNAME: "${DB_USERNAME}"
  SPRING_DATASOURCE_PASSWORD: "${DB_PASSWORD}"
  
  # Redis 凭证
  SPRING_REDIS_PASSWORD: "${REDIS_PASSWORD}"
  
  # Kafka 凭证（如果使用 SASL）
  # SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG: "${KAFKA_JAAS_CONFIG}"
  
  # 平台 API 密钥
  PLATFORM_SERVICE_API_KEY: "${PLATFORM_API_KEY}"
  PLATFORM_SERVICE_API_SECRET: "${PLATFORM_API_SECRET}"
---
