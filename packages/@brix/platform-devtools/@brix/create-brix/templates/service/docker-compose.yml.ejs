# =====================================================
# v2.1 服务 docker-compose.yml - <%= fullName %>
# 
# <%= description %>
# 
# 数据库模式（通过环境变量控制）：
# - Total享模式（Default）：连接 platform-postgres，数据库名 shinwa_<%= name %>
# - 独立模式：设置 DB_HOST, DB_PORT, DB_NAME 等环境变量
# 
# 前置items件：platform-host-web 的 docker-compose 已启动
# 使用方法：
# $ docker-compose up -d --build
# 
# 切换到独立数据库示例：
# $ DB_HOST=my-rds.xxx.rds.amazonaws.com DB_NAME=mydb docker-compose up -d
# =====================================================

services:
  # =====================================================
  # <%= displayName %>
  # 组装插件：<% if (plugins.length > 0) { %><%= plugins.map(p => p.name).join(' + ') %><% } else { %>（暂无）<% } %>
  # =====================================================
  <%= name %>:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: <%= fullName %>
    ports:
      - "<%= port %>:<%= port %>"
    environment:
      # 服务配置
      - SERVER_PORT=<%= port %>
      - SPRING_PROFILES_ACTIVE=docker
      # 数据库配置（支持环境变量覆盖，便于切换独立数据库）
      - SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST:-platform-postgres}:${DB_PORT:-5432}/${DB_NAME:-shinwa_<%= name %>}
      - SPRING_DATASOURCE_USERNAME=${DB_USERNAME:-platform}
      - SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD:-platform123}
      # Redis 配置（支持环境变量覆盖）
      - SPRING_DATA_REDIS_HOST=${REDIS_HOST:-platform-redis}
      - SPRING_DATA_REDIS_PORT=${REDIS_PORT:-6379}
      # Kafka 配置（支持环境变量覆盖）
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_SERVERS:-kafka:29092}
      # 基座网关地址（用于服务注册）
      - PLATFORM_HOST_URL=${PLATFORM_URL:-http://platform-gateway:8080}
      # API Key 认证（用于向 Plugin Engine 注册）
      - SHINWA_SERVICE_API_KEY=${API_KEY:-shinwa-plugin-service-api-key-v1}
      - SHINWA_SERVICE_API_SECRET=${API_SECRET:-shinwa-plugin-service-api-secret-v1-32chars}
      # OpenTelemetry 链路追踪
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_ENDPOINT:-http://platform-jaeger:4317}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:<%= port %>/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 90s
<% if (plugins.length > 0) { %>
<% plugins.forEach((plugin, index) => { %>
<% const webPort = 3001 + index; %>
  # =====================================================
  # <%= plugin.name %>-web 前端服务
  # =====================================================
  <%= plugin.name.replace('plugin-', '') %>-web:
    build:
      # 构建上下文设置为工作区根目录（D:\1.Sources）
      context: ../..
      dockerfile: plugins/<%= plugin.name %>/<%= plugin.name %>-web/Dockerfile.dev
    container_name: shinwa-<%= plugin.name %>-web
    ports:
      - "<%= webPort %>:<%= webPort %>"
    environment:
      - PORT=<%= webPort %>
      - GATEWAY_URL=http://platform-gateway:8080
    volumes:
      # 开发模式挂载源码以支持热更新
      - ../../plugins/<%= plugin.name %>/<%= plugin.name %>-web/src:/app/plugin/src:ro
      - ../../plugins/<%= plugin.name %>/<%= plugin.name %>-web/public:/app/plugin/public:ro
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:<%= webPort %>/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    depends_on:
      <%= name %>:
        condition: service_healthy
<% }); %>
<% } %>

# 使用平台基座的网络（独立部署时可改为自定义网络）
networks:
  default:
    name: ${DOCKER_NETWORK:-docker_default}
    external: true
