package <%= packageName %>.api.dto;

import lombok.Data;
import lombok.Builder;
import lombok.NoArgsConstructor;
import lombok.AllArgsConstructor;

import java.io.Serializable;
import java.time.LocalDateTime;

/**
 * <%= displayName %> Data Transfer Object
 * 
 * <p>Standard DTO for inter-module data transfer with basic business fields。</p>
 * 
 * <p>[v3.0 Architecture]</p>
 * <ul>
 *   <li>DTOs are placed in the api module for other modules to depend on</li>
 *   <li>Contains only data fields, no business logic</li>
 *   <li>Uses Lombok to simplify code</li>
 * </ul>
 * 
 * @author <%= author %>
 * @date <%= date %>
 * @version <%= version %>
 */
@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
public class <%= classPrefix %>DTO implements Serializable {

    private static final long serialVersionUID = 1L;

    /**
     * Unique identifier
     */
    private String id;

    /**
     * Name
     */
    private String name;

    /**
     * Description
     */
    private String description;

    /**
     * Status
     * <p>Possible values：DRAFT, ACTIVE, COMPLETED, CANCELLED</p>
     */
    private String status;

    /**
     * Tenant ID
     * <p>Tenant identifier in multi-tenant architecture</p>
     */
    private String tenantId;

    /**
     * Creator ID
     */
    private String createdBy;

    /**
     * Created at
     */
    private LocalDateTime createdAt;

    /**
     * Updater ID
     */
    private String updatedBy;

    /**
     * Updated at
     */
    private LocalDateTime updatedAt;
}
