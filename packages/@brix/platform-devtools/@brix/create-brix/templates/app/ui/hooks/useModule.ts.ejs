/**
 * @file <%= displayName %> Hooks（Web）
 * @description ViewModel 层 — 业务逻辑和Status管理
 * @module @brix/<%= name %>-ui-web
 * @version <%= version %>
 *
 * Generated by @brix/create-brix <%= date %> Auto-generated
 *
 * [Design Notes]
 * 遵循 v3.0.4 蓝图 MVVM 分层架构，Hooks 作为 ViewModel 层：
 * 1. 封装业务逻辑和Status管理
 * 2. 通过 useHttp() 获取 HttpCapability
 * 3. Calls Repository 层获取数据
 * 4. 向 View 层提供响应式Status和操作方法
 *
 * 【架构红线】
 * - Hooks 通过 Repository 层访问数据，禁止直接使用 fetch/axios
 * - Hooks 不包含 UI 渲染逻辑
 * - HttpCapability 通过 useHttp() 注入
 *
 * @author <%= author %>
 * @date <%= date %>
 */

import { useState, useEffect, useCallback, useMemo } from 'react';
import { useHttp } from '@brix-sdk/runtime-sdk-react';
import type { <%= classPrefix %>, Create<%= classPrefix %>Request, Update<%= classPrefix %>Request, PagedResponse } from '@brix/<%= name %>-shared';
import { create<%= classPrefix %>Repository, type <%= classPrefix %>QueryParams } from '../repositories';

// ============================================================================
// 列表 Hook
// ============================================================================

/**
 * <%= displayName %> 列表 Hook BackType
 */
export interface Use<%= classPrefix %>ListResult {
  /** 数据列表 */
  items: <%= classPrefix %>[];
  /** 是否正在加载 */
  isLoading: boolean;
  /** 错误信息 */
  error: Error | null;
  /** 分pages信息 */
  pagination: {
    page: number;
    size: number;
    total: number;
    totalPages: number;
  };
  /** Refresh列表 */
  refresh: () => Promise<void>;
  /** 切换pages码 */
  setPage: (page: number) => void;
  /** 设置每pages大小 */
  setPageSize: (size: number) => void;
  /** Search */
  search: (keyword: string) => void;
  /** 按Status筛选 */
  filterByStatus: (status: string | undefined) => void;
  /** Delete项目 */
  deleteItem: (id: number) => Promise<void>;
}

/**
 * <%= displayName %> 列表 Hook
 *
 * 封装列表数据获取、分pages、Search、筛选等业务逻辑。
 *
 * @returns 列表Status和操作方法
 *
 * @example
 * ```tsx
 * const { items, isLoading, error, pagination, refresh, deleteItem } = use<%= classPrefix %>List();
 * ```
 */
export function use<%= classPrefix %>List(): Use<%= classPrefix %>ListResult {
  // 通过 useHttp 获取 HttpCapability
  const http = useHttp();

  // Status
  const [items, setItems] = useState<<%= classPrefix %>[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);
  const [params, setParams] = useState<<%= classPrefix %>QueryParams>({
    page: 0,
    size: 20,
  });
  const [pagination, setPagination] = useState({
    page: 0,
    size: 20,
    total: 0,
    totalPages: 0,
  });

  // 创建 Repository 实例（使用 useMemo 避免重复创建）
  const repository = useMemo(
    () => create<%= classPrefix %>Repository(http),
    [http]
  );

  // 加载数据
  const loadData = useCallback(async () => {
    try {
      setIsLoading(true);
      setError(null);

      const response: PagedResponse<<%= classPrefix %>> = await repository.list(params);

      setItems(response.content);
      setPagination({
        page: response.number,
        size: response.size,
        total: response.totalElements,
        totalPages: response.totalPages,
      });
    } catch (err) {
      setError(err instanceof Error ? err : new Error(String(err)));
    } finally {
      setIsLoading(false);
    }
  }, [repository, params]);

  // 参数变化时重新加载
  useEffect(() => {
    loadData();
  }, [loadData]);

  // Refresh
  const refresh = useCallback(async () => {
    await loadData();
  }, [loadData]);

  // 切换pages码
  const setPage = useCallback((page: number) => {
    setParams(prev => ({ ...prev, page }));
  }, []);

  // 设置每pages大小
  const setPageSize = useCallback((size: number) => {
    setParams(prev => ({ ...prev, size, page: 0 }));
  }, []);

  // Search
  const search = useCallback((keyword: string) => {
    setParams(prev => ({ ...prev, keyword: keyword || undefined, page: 0 }));
  }, []);

  // 按Status筛选
  const filterByStatus = useCallback((status: string | undefined) => {
    setParams(prev => ({ ...prev, status, page: 0 }));
  }, []);

  // Delete项目
  const deleteItem = useCallback(async (id: number) => {
    try {
      await repository.delete(id);
      // Delete成功后Refresh列表
      await loadData();
    } catch (err) {
      throw err instanceof Error ? err : new Error(String(err));
    }
  }, [repository, loadData]);

  return {
    items,
    isLoading,
    error,
    pagination,
    refresh,
    setPage,
    setPageSize,
    search,
    filterByStatus,
    deleteItem,
  };
}

