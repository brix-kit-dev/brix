 */
export interface Use<%= classPrefix %>CreateResult {
  /** 是否正在Submit */
  isSubmitting: boolean;
  /** 错误信息 */
  error: Error | null;
  /** 创建 */
  create: (data: Create<%= classPrefix %>Request) => Promise<<%= classPrefix %>>;
  /** Reset错误 */
  resetError: () => void;
}

/**
 * <%= displayName %> 创建 Hook
 *
 * 封装创建业务逻辑。
 *
 * @returns 创建Status和操作方法
 *
 * @example
 * ```tsx
 * const { isSubmitting, error, create } = use<%= classPrefix %>Create();
 * const handleSubmit = async (data) => {
 *   const created = await create(data);
 *   navigate(`/<%= name.replace(/-/g, '/') %>/${created.id}`);
 * };
 * ```
 */
export function use<%= classPrefix %>Create(): Use<%= classPrefix %>CreateResult {
  const http = useHttp();

  // Status
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  // 创建 Repository 实例
  const repository = useMemo(
    () => create<%= classPrefix %>Repository(http),
    [http]
  );

  // 创建
  const create = useCallback(async (data: Create<%= classPrefix %>Request): Promise<<%= classPrefix %>> => {
    try {
      setIsSubmitting(true);
      setError(null);

      const created = await repository.create(data);
      return created;
    } catch (err) {
      const error = err instanceof Error ? err : new Error(String(err));
      setError(error);
      throw error;
    } finally {
      setIsSubmitting(false);
    }
  }, [repository]);

  // Reset错误
  const resetError = useCallback(() => {
    setError(null);
  }, []);

  return {
    isSubmitting,
    error,
    create,
    resetError,
  };
}

