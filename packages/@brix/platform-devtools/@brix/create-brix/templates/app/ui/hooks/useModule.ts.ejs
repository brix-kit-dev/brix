/**
 * <%= displayName %> 详情 Hook BackType
 */
export interface Use<%= classPrefix %>DetailResult {
  /** 详情数据 */
  item: <%= classPrefix %> | null;
  /** 是否正在加载 */
  isLoading: boolean;
  /** 错误信息 */
  error: Error | null;
  /** Refresh详情 */
  refresh: () => Promise<void>;
  /** 更新 */
  updateItem: (data: Update<%= classPrefix %>Request) => Promise<<%= classPrefix %>>;
  /** Delete */
  deleteItem: () => Promise<void>;
}

/**
 * <%= displayName %> 详情 Hook
 *
 * 封装详情数据获取、更新、Delete等业务逻辑。
 *
 * @param id 资源 ID
 * @returns 详情Status和操作方法
 *
 * @example
 * ```tsx
 * const { item, isLoading, error, updateItem, deleteItem } = use<%= classPrefix %>Detail(id);
 * ```
 */
export function use<%= classPrefix %>Detail(id: number | string): Use<%= classPrefix %>DetailResult {
  const http = useHttp();
  const numericId = typeof id === 'string' ? Number(id) : id;

  // Status
  const [item, setItem] = useState<<%= classPrefix %> | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);

  // 创建 Repository 实例
  const repository = useMemo(
    () => create<%= classPrefix %>Repository(http),
    [http]
  );

  // 加载详情
  const loadDetail = useCallback(async () => {
    try {
      setIsLoading(true);
      setError(null);

      const data = await repository.getById(numericId);
      setItem(data);
    } catch (err) {
      setError(err instanceof Error ? err : new Error(String(err)));
    } finally {
      setIsLoading(false);
    }
  }, [repository, numericId]);

  // ID 变化时重新加载
  useEffect(() => {
    if (numericId) {
      loadDetail();
    }
  }, [numericId, loadDetail]);

  // 更新
  const updateItem = useCallback(async (data: Update<%= classPrefix %>Request): Promise<<%= classPrefix %>> => {
    try {
      const updated = await repository.update(numericId, data);
      setItem(updated);
      return updated;
    } catch (err) {
      throw err instanceof Error ? err : new Error(String(err));
    }
  }, [repository, numericId]);

  // Delete
  const deleteItem = useCallback(async () => {
    try {
      await repository.delete(numericId);
      setItem(null);
    } catch (err) {
      throw err instanceof Error ? err : new Error(String(err));
    }
  }, [repository, numericId]);

  return {
    item,
    isLoading,
    error,
    refresh: loadDetail,
    updateItem,
    deleteItem,
  };
}

