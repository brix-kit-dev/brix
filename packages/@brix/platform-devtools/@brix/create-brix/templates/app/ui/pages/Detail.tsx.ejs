import React from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { use<%= classPrefix %>Detail } from '../hooks/use<%= classPrefix %>';

/**
 * <%= displayName %> Detail Page组件
 */
const <%= classPrefix %>DetailPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const {
    item,
    isLoading,
    error,
    refresh,
    deleteItem,
  } = use<%= classPrefix %>Detail(id || '');

  // Back列表pages
  const handleBack = () => {
    navigate('/<%= name.replace(/-/g, '/') %>');
  };

  // 跳转Editpages
  const handleEdit = () => {
    navigate(`/<%= name.replace(/-/g, '/') %>/${id}/edit`);
  };

  // DeleteConfirm
  const handleDelete = async () => {
    if (window.confirm('确定要Delete吗？')) {
      try {
        await deleteItem();
        navigate('/<%= name.replace(/-/g, '/') %>');
      } catch (err) {
        alert('Delete失败: ' + (err instanceof Error ? err.message : String(err)));
      }
    }
  };

  // LoadingStatus
  if (isLoading) {
    return (
      <div style={styles.container}>
        <div style={styles.loading}>Loading...</div>
      </div>
    );
  }

  // 错误Status
  if (error) {
    return (
      <div style={styles.container}>
        <div style={styles.error}>
          加载失败: {error.message}
          <button onClick={refresh} style={styles.retryButton}>重试</button>
        </div>
      </div>
    );
  }

  // 未找到数据
  if (!item) {
    return (
      <div style={styles.container}>
        <div style={styles.empty}>未找到数据</div>
        <button onClick={handleBack} style={styles.backButton}>Back列表</button>
      </div>
    );
  }

  return (
    <div style={styles.container}>
      {/* pages面头部 */}
      <div style={styles.header}>
        <button onClick={handleBack} style={styles.backButton}>
          ← Back
        </button>
        <div style={styles.actions}>
          <button onClick={handleEdit} style={styles.editButton}>Edit</button>
          <button onClick={handleDelete} style={styles.deleteButton}>Delete</button>
        </div>
      </div>

      {/* 详情卡片 */}
      <div style={styles.card}>
        <div style={styles.cardHeader}>
          <h1 style={styles.title}>{item.name}</h1>
          <span style={styles.status}>{item.status}</span>
        </div>

        {/* Description */}
        {item.description && (
          <div style={styles.section}>
            <h3 style={styles.sectionTitle}>Description</h3>
            <p style={styles.description}>{item.description}</p>
          </div>
        )}

        {/* 基本信息 */}
        <div style={styles.section}>
          <h3 style={styles.sectionTitle}>基本信息</h3>
          <div style={styles.infoGrid}>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>ID</label>
              <span style={styles.infoValue}>{item.id}</span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>Name</label>
              <span style={styles.infoValue}>{item.name}</span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>Status</label>
              <span style={styles.infoValue}>{item.status}</span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>Created at</label>
              <span style={styles.infoValue}>
                {new Date(item.createdAt).toLocaleString()}
              </span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>Updated at</label>
              <span style={styles.infoValue}>
                {new Date(item.updatedAt).toLocaleString()}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

