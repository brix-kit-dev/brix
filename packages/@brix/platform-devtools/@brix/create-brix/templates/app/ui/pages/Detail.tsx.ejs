/**
 * @file <%= displayName %> 详情页面
 * @description View 层 — 纯展示组件
 * @module @shinwa/<%= name %>-ui-web
 * @version <%= version %>
 *
 * 由 @brix/create-brix <%= date %> 自动生成
 *
 * 【v3.0.4 UI 架构说明】
 * 遵循三层分离架构：View → ViewModel → Repository
 * - View 层：纯渲染组件，不包含业务逻辑
 * - 数据和操作通过 use<%= classPrefix %>Detail Hook 获取
 * - 禁止直接调用 HTTP/fetch/axios
 *
 * @author <%= author %>
 * @date <%= date %>
 */

import React from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { use<%= classPrefix %>Detail } from '../hooks/use<%= classPrefix %>';

/**
 * <%= displayName %> 详情页面组件
 */
const <%= classPrefix %>DetailPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const {
    item,
    isLoading,
    error,
    refresh,
    deleteItem,
  } = use<%= classPrefix %>Detail(id || '');

  // 返回列表页
  const handleBack = () => {
    navigate('/<%= name.replace(/-/g, '/') %>');
  };

  // 跳转编辑页
  const handleEdit = () => {
    navigate(`/<%= name.replace(/-/g, '/') %>/${id}/edit`);
  };

  // 删除确认
  const handleDelete = async () => {
    if (window.confirm('确定要删除吗？')) {
      try {
        await deleteItem();
        navigate('/<%= name.replace(/-/g, '/') %>');
      } catch (err) {
        alert('删除失败: ' + (err instanceof Error ? err.message : String(err)));
      }
    }
  };

  // 加载中状态
  if (isLoading) {
    return (
      <div style={styles.container}>
        <div style={styles.loading}>加载中...</div>
      </div>
    );
  }

  // 错误状态
  if (error) {
    return (
      <div style={styles.container}>
        <div style={styles.error}>
          加载失败: {error.message}
          <button onClick={refresh} style={styles.retryButton}>重试</button>
        </div>
      </div>
    );
  }

  // 未找到数据
  if (!item) {
    return (
      <div style={styles.container}>
        <div style={styles.empty}>未找到数据</div>
        <button onClick={handleBack} style={styles.backButton}>返回列表</button>
      </div>
    );
  }

  return (
    <div style={styles.container}>
      {/* 页面头部 */}
      <div style={styles.header}>
        <button onClick={handleBack} style={styles.backButton}>
          ← 返回
        </button>
        <div style={styles.actions}>
          <button onClick={handleEdit} style={styles.editButton}>编辑</button>
          <button onClick={handleDelete} style={styles.deleteButton}>删除</button>
        </div>
      </div>

      {/* 详情卡片 */}
      <div style={styles.card}>
        <div style={styles.cardHeader}>
          <h1 style={styles.title}>{item.name}</h1>
          <span style={styles.status}>{item.status}</span>
        </div>

        {/* 描述 */}
        {item.description && (
          <div style={styles.section}>
            <h3 style={styles.sectionTitle}>描述</h3>
            <p style={styles.description}>{item.description}</p>
          </div>
        )}

        {/* 基本信息 */}
        <div style={styles.section}>
          <h3 style={styles.sectionTitle}>基本信息</h3>
          <div style={styles.infoGrid}>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>ID</label>
              <span style={styles.infoValue}>{item.id}</span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>名称</label>
              <span style={styles.infoValue}>{item.name}</span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>状态</label>
              <span style={styles.infoValue}>{item.status}</span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>创建时间</label>
              <span style={styles.infoValue}>
                {new Date(item.createdAt).toLocaleString()}
              </span>
            </div>
            <div style={styles.infoItem}>
              <label style={styles.infoLabel}>更新时间</label>
              <span style={styles.infoValue}>
                {new Date(item.updatedAt).toLocaleString()}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

