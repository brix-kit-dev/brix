import React from 'react';
import { useNavigate } from 'react-router-dom';
import { use<%= classPrefix %>List } from '../hooks/use<%= classPrefix %>';
import type { <%= classPrefix %> } from '@brix/<%= name %>-shared';

/**
 * <%= displayName %> 列表pages面组件
 */
const <%= classPrefix %>ListPage: React.FC = () => {
  const navigate = useNavigate();
  const {
    items,
    isLoading,
    error,
    pagination,
    refresh,
    setPage,
    deleteItem,
  } = use<%= classPrefix %>List();

  // 跳转详情pages
  const handleViewDetail = (id: number) => {
    navigate(`/<%= name.replace(/-/g, '/') %>/${id}`);
  };

  // 跳转Createpages
  const handleCreate = () => {
    navigate(`/<%= name.replace(/-/g, '/') %>/create`);
  };

  // DeleteConfirm
  const handleDelete = async (id: number, e: React.MouseEvent) => {
    e.stopPropagation();
    if (window.confirm('确定要Delete吗？')) {
      try {
        await deleteItem(id);
      } catch (err) {
        alert('Delete失败: ' + (err instanceof Error ? err.message : String(err)));
      }
    }
  };

  // LoadingStatus
  if (isLoading && items.length === 0) {
    return (
      <div style={styles.container}>
        <div style={styles.loading}>Loading...</div>
      </div>
    );
  }

  // 错误Status
  if (error) {
    return (
      <div style={styles.container}>
        <div style={styles.error}>
          加载失败: {error.message}
          <button onClick={refresh} style={styles.retryButton}>重试</button>
        </div>
      </div>
    );
  }

  return (
    <div style={styles.container}>
      {/* pages面头部 */}
      <div style={styles.header}>
        <h1 style={styles.title}><%= displayName %></h1>
        <button onClick={handleCreate} style={styles.createButton}>
          + Create
        </button>
      </div>

      {/* 列表 */}
      <div style={styles.listContainer}>
        {items.length === 0 ? (
          <div style={styles.empty}>No data</div>
        ) : (
          items.map((item: <%= classPrefix %>) => (
            <div
              key={item.id}
              style={styles.listItem}
              onClick={() => handleViewDetail(item.id)}
            >
              <div style={styles.itemContent}>
                <div style={styles.itemName}>{item.name}</div>
                <div style={styles.itemDescription}>
                  {item.description || '暂无Description'}
                </div>
                <div style={styles.itemMeta}>
                  <span style={styles.itemStatus}>{item.status}</span>
                  <span style={styles.itemDate}>
                    {new Date(item.createdAt).toLocaleDateString()}
                  </span>
                </div>
              </div>
              <div style={styles.itemActions}>
                <button
                  onClick={(e) => handleDelete(item.id, e)}
                  style={styles.deleteButton}
                >
                  Delete
                </button>
              </div>
            </div>
          ))
        )}
      </div>

      {/* 分pages */}
      {pagination.totalPages > 1 && (
        <div style={styles.pagination}>
          <button
            onClick={() => setPage(pagination.page - 1)}
            disabled={pagination.page === 0}
            style={styles.pageButton}
          >
            上一pages
          </button>
          <span style={styles.pageInfo}>
            第 {pagination.page + 1} / {pagination.totalPages} pages（Total {pagination.total} items）
          </span>
          <button
            onClick={() => setPage(pagination.page + 1)}
            disabled={pagination.page >= pagination.totalPages - 1}
            style={styles.pageButton}
          >
            Next
          </button>
        </div>
      )}
    </div>
  );
};

