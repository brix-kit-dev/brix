<?xml version="1.0" encoding="UTF-8"?>
<!--
  v3.0 业务应用module父 POM
  
  module结构：
  - <%= name %>-api:  API module（DTO、Event、Request）
  - <%= name %>-core: 业务逻辑module
  - <%= name %>-ui:   前端界面module（NPM 包）
  - <%= name %>-app:  可独立运行的启动module
  
  遵循 v3.0 运行壳架构设计蓝图：
  - 仅依赖 io.runtime:runtime-sdk（能力契约）
  - 不直接依赖 Kafka/Redis/HTTP 等基础设施
  
  @author <%= author %>
  @date <%= date %>
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent POM: Inherits from enterprise-solutions for unified management -->
    <parent>
        <groupId>io.brix.enterprise</groupId>
        <artifactId>enterprise-solutions</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.brix.enterprise.app</groupId>
    <artifactId><%= fullName %></artifactId>
    <version><%= version %></version>
    <packaging>pom</packaging>

    <name><%= displayName %></name>
    <description><%= description %></description>

    <!-- 子module -->
    <modules>
<% if (withApi) { -%>
        <<%= name %>-api></<%= name %>-api>
<% } -%>
<% if (withCore) { -%>
        <<%= name %>-core></<%= name %>-core>
<% } -%>
<% if (withApp) { -%>
        <<%= name %>-app></<%= name %>-app>
<% } -%>
    </modules>

    <properties>
        <!-- 版本管理 -->
        <runtime-sdk.version>3.0.0-SNAPSHOT</runtime-sdk.version>
        <spring-boot.version>3.2.0</spring-boot.version>
        
        <!-- 编译配置 -->
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 依赖管理 -->
    <dependencyManagement>
        <dependencies>
            <!-- v3.0 运行时 SDK（能力契约） -->
            <dependency>
                <groupId>io.runtime</groupId>
                <artifactId>runtime-sdk-api</artifactId>
                <version>${runtime-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.runtime</groupId>
                <artifactId>runtime-sdk</artifactId>
                <version>${runtime-sdk.version}</version>
            </dependency>
            
            <!-- 内部module -->
<% if (withApi) { -%>
            <dependency>
                <groupId>com.shinwa.app</groupId>
                <artifactId><%= name %>-api</artifactId>
                <version>${project.version}</version>
            </dependency>
<% } -%>
<% if (withCore) { -%>
            <dependency>
                <groupId>com.shinwa.app</groupId>
                <artifactId><%= name %>-core</artifactId>
                <version>${project.version}</version>
            </dependency>
<% } -%>
            
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
