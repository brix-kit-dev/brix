package <%= packageName %>;

import com.shinwa.runtime.RuntimeContext;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.ApplicationContext;

/**
 * <%= displayName %> 应用启动类
 * 
 * <p>【v3.0 架构说明】</p>
 * <p>作为 v3.0 App 模块的启动入口，本类负责：</p>
 * <ul>
 *   <li>初始化 Spring Boot 应用上下文</li>
 *   <li>从 RuntimeContext 获取运行时能力</li>
 *   <li>注册模块元数据到运行时</li>
 * </ul>
 * 
 * <p>【能力契约】</p>
 * <p>本应用通过 RuntimeContext 声明式获取所需能力：</p>
 * <ul>
 *   <li>HttpCapability - HTTP 客户端能力</li>
 *   <li>MessagingCapability - 消息队列能力</li>
 *   <li>CacheCapability - 缓存能力</li>
 *   <li>StorageCapability - 存储能力</li>
 * </ul>
 * 
 * @author <%= author %>
 * @version <%= version %>
 * @since <%= date %>
 * @see RuntimeContext
 */
@SpringBootApplication(scanBasePackages = {
    "<%= packageName %>",
    "com.shinwa.runtime",
    "com.shinwa.platform"
})
public class <%= classPrefix %>Application {

    private static final Logger log = LoggerFactory.getLogger(<%= classPrefix %>Application.class);

    /**
     * 应用程序入口点
     * 
     * @param args 命令行参数
     */
    public static void main(String[] args) {
        // 打印启动 Banner
        printBanner();

        // 启动 Spring Boot 应用
        ApplicationContext context = SpringApplication.run(<%= classPrefix %>Application.class, args);

        // 获取 RuntimeContext 并打印能力信息
        RuntimeContext runtime = context.getBean(RuntimeContext.class);
        printCapabilities(runtime);

        log.info("========================================");
        log.info("<%= displayName %> 启动完成");
        log.info("模块名称: <%= name %>");
        log.info("版本: <%= version %>");
        log.info("========================================");
    }

    /**
     * 打印启动 Banner
     */
    private static void printBanner() {
        String banner = """
            
            ╔═══════════════════════════════════════════════════════════════╗
            ║                                                               ║
            ║   <%= displayName.padEnd(55) %> ║
            ║                                                               ║
            ║   Powered by Shinwa Platform v3.0                             ║
            ║   Runtime Shell Architecture                                  ║
            ║                                                               ║
            ╚═══════════════════════════════════════════════════════════════╝
            """;
        System.out.println(banner);
    }

    /**
     * 打印运行时能力信息
     * 
     * @param runtime RuntimeContext 实例
     */
    private static void printCapabilities(RuntimeContext runtime) {
        log.info("运行时能力已注入:");
        log.info("  - HTTP 能力: {}", runtime.getCapability("http") != null ? "已就绪" : "未配置");
        log.info("  - 消息能力: {}", runtime.getCapability("messaging") != null ? "已就绪" : "未配置");
        log.info("  - 缓存能力: {}", runtime.getCapability("cache") != null ? "已就绪" : "未配置");
        log.info("  - 存储能力: {}", runtime.getCapability("storage") != null ? "已就绪" : "未配置");
    }
}
