<?xml version="1.0" encoding="UTF-8"?>
<!--
  <%= fullName %>-core 模块
  
  Core 模块包含：
  - Entity（实体）
  - Repository（仓储）
  - Service（服务）
  - Handler（事件处理器）
  - Controller（REST 控制器）
  
  【v3.0 核心约束】
  ★ 仅通过 RuntimeContext 访问能力，禁止直接依赖 Kafka/Redis 等基础设施
  ★ 所有跨模块通信通过 EventBusCapability 完成
  ★ 配置通过 ConfigStoreCapability 获取
  
  @author <%= author %>
  @date <%= date %>
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.app</groupId>
        <artifactId><%= fullName %></artifactId>
        <version><%= version %></version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId><%= name %>-core</artifactId>
    <packaging>jar</packaging>

    <name><%= displayName %> - Core</name>
    <description><%= displayName %> 业务逻辑模块</description>

    <dependencies>
        <!-- ===== 内部依赖 ===== -->
<% if (withApi) { -%>
        <!-- API 模块（DTO、Event） -->
        <dependency>
            <groupId>com.shinwa.app</groupId>
            <artifactId><%= name %>-api</artifactId>
        </dependency>
<% } -%>

        <!-- ===== v3.0 运行时 SDK ===== -->
        <!-- 【核心】运行时能力契约 -->
        <dependency>
            <groupId>io.runtime</groupId>
            <artifactId>runtime-sdk</artifactId>
        </dependency>

        <!-- ===== Spring 框架 ===== -->
        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- Spring Data JPA（数据持久化） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Validation（参数校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== 工具类 ===== -->
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- MapStruct（对象映射） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.5.5.Final</version>
        </dependency>

        <!-- ===== 测试依赖 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===== 架构守护（ArchUnit 红线约束）===== -->
        <!--
            【自动生成】由 create-brix 脚手架内置
            配合 ArchitectureTest.java 自动启用全部 8 条架构红线
        -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.5.5.Final</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
