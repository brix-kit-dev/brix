package <%= packageName %>.core.entity;

import jakarta.persistence.*;
import lombok.Data;
import lombok.NoArgsConstructor;
import lombok.AllArgsConstructor;
import lombok.Builder;
import org.hibernate.annotations.Filter;
import org.hibernate.annotations.FilterDef;
import org.hibernate.annotations.ParamDef;

import java.time.LocalDateTime;

/**
 * <%= displayName %> 实体
 * 
 * <p>数据库持久化实体，对应 <%= name %> 表。</p>
 * 
 * <p>【v3.0 多租户支持】</p>
 * <ul>
 *   <li>使用 Hibernate Filter 实现租户数据隔离</li>
 *   <li>tenant_id 字段由 TenantContext 自动填充</li>
 *   <li>查询时自动添加租户过滤条件</li>
 * </ul>
 * 
 * @author <%= author %>
 * @date <%= date %>
 * @version <%= version %>
 */
@Data
@Entity
@Builder
@NoArgsConstructor
@AllArgsConstructor
@Table(name = "<%= name.replace(/-/g, '_') %>")
@FilterDef(name = "tenantFilter", parameters = @ParamDef(name = "tenantId", type = String.class))
@Filter(name = "tenantFilter", condition = "tenant_id = :tenantId")
public class <%= classPrefix %>Entity {

    /**
     * 主键 ID
     * <p>使用 UUID 策略生成</p>
     */
    @Id
    @GeneratedValue(strategy = GenerationType.UUID)
    @Column(name = "id", length = 36)
    private String id;

    /**
     * 名称
     */
    @Column(name = "name", nullable = false, length = 100)
    private String name;

    /**
     * 描述
     */
    @Column(name = "description", length = 500)
    private String description;

    /**
     * 状态
     * <p>可选值：DRAFT, ACTIVE, COMPLETED, CANCELLED</p>
     */
    @Column(name = "status", length = 20)
    private String status;

    /**
     * 租户 ID
     * <p>【v3.0 多租户】不可为空，用于数据隔离</p>
     */
    @Column(name = "tenant_id", nullable = false, length = 36)
    private String tenantId;

    /**
     * 创建者 ID
     */
    @Column(name = "created_by", length = 36)
    private String createdBy;

    /**
     * 创建时间
     */
    @Column(name = "created_at", nullable = false, updatable = false)
    private LocalDateTime createdAt;

    /**
     * 更新者 ID
     */
    @Column(name = "updated_by", length = 36)
    private String updatedBy;

    /**
     * 更新时间
     */
    @Column(name = "updated_at")
    private LocalDateTime updatedAt;

    /**
     * 新增时自动设置创建时间
     */
    @PrePersist
    protected void onCreate() {
        this.createdAt = LocalDateTime.now();
        this.updatedAt = this.createdAt;
    }

    /**
     * 更新时自动设置更新时间
     */
    @PreUpdate
    protected void onUpdate() {
        this.updatedAt = LocalDateTime.now();
    }
}
