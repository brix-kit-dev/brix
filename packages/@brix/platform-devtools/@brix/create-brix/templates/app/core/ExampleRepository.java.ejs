package <%= packageName %>.core.repository;

import <%= packageName %>.core.entity.<%= classPrefix %>Entity;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.util.List;
import java.util.Optional;

/**
 * <%= displayName %> 数据仓储
 * 
 * <p>提供<%= displayName %>实体的数据访问操作。</p>
 * 
 * <p>[v3.0 Architecture]</p>
 * <ul>
 *   <li>继承 JpaRepository 获得标准 CRUD 操作</li>
 *   <li>自定义查询方法遵循 Spring Data 命名规范</li>
 *   <li>多租户过滤由 Hibernate Filter 自动处理</li>
 * </ul>
 * 
 * @author <%= author %>
 * @date <%= date %>
 * @version <%= version %>
 */
@Repository
public interface <%= classPrefix %>Repository extends JpaRepository<<%= classPrefix %>Entity, String> {

    /**
     * 根据Tenant ID 和Name查找
     * 
     * @param tenantId Tenant ID
     * @param name Name
     * @return 实体（Optional）
     */
    Optional<<%= classPrefix %>Entity> findByTenantIdAndName(String tenantId, String name);

    /**
     * 根据Tenant ID 查找所有记录
     * 
     * @param tenantId Tenant ID
     * @return 实体列表
     */
    List<<%= classPrefix %>Entity> findByTenantId(String tenantId);

    /**
     * 根据Tenant ID 分pages查找
     * 
     * @param tenantId Tenant ID
     * @param pageable 分pages参数
     * @return 分pages结果
     */
    Page<<%= classPrefix %>Entity> findByTenantId(String tenantId, Pageable pageable);

    /**
     * 根据Tenant ID 和Status查找
     * 
     * @param tenantId Tenant ID
     * @param status Status
     * @return 实体列表
     */
    List<<%= classPrefix %>Entity> findByTenantIdAndStatus(String tenantId, String status);

    /**
     * 根据Tenant ID 和Name模糊Search
     * 
     * @param tenantId Tenant ID
     * @param keyword Search关键词
     * @param pageable 分pages参数
     * @return 分pages结果
     */
    @Query("SELECT e FROM <%= classPrefix %>Entity e WHERE e.tenantId = :tenantId AND e.name LIKE %:keyword%")
    Page<<%= classPrefix %>Entity> searchByName(
        @Param("tenantId") String tenantId,
        @Param("keyword") String keyword,
        Pageable pageable
    );

    /**
     * 检查Name是否已存在（同一租户内）
     * 
     * @param tenantId Tenant ID
     * @param name Name
     * @return 是否存在
     */
    boolean existsByTenantIdAndName(String tenantId, String name);
}
