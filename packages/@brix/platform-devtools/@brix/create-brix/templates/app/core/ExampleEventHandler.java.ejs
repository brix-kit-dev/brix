package <%= packageName %>.core.handler;

import io.runtime.sdk.annotation.EventHandler;
import io.runtime.sdk.event.DomainEvent;
import io.runtime.sdk.context.RuntimeContext;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

/**
 * <%= displayName %> Event Handler
 * 
 * <p>Handles external events subscribed by this module.</p>
 * 
 * <p><b>v3.0 Event Handling Mechanism</b></p>
 * <ul>
 *   <li>Use @EventHandler annotation to declare event handling methods</li>
 *   <li>Subscribed events must be declared in module-manifest.yaml under events.subscribes</li>
 *   <li>Runtime Shell automatically routes events based on manifest configuration</li>
 *   <li>Handler methods must be idempotent (support retry)</li>
 * </ul>
 * 
 * <p><b>Usage Example</b></p>
 * <pre>{@code
 * // Declare subscription in module-manifest.yaml
 * events:
 *   subscribes:
 *     - type: "UserCreatedEvent"
 *       handler: "<%= classPrefix %>EventHandler.onUserCreated"
 * }</pre>
 * 
 * @author <%= author %>
 * @date <%= date %>
 * @version <%= version %>
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class <%= classPrefix %>EventHandler {

    /**
     * [v3.0 Core] Runtime context
     */
    private final RuntimeContext runtimeContext;

    /**
     * Handle user created event (example)
     * 
     * <p>This method is automatically called by Runtime Shell when UserCreatedEvent is published.</p>
     * 
     * <p><b>Idempotency Requirements</b></p>
     * <ul>
     *   <li>Use event ID for deduplication</li>
     *   <li>Repeated processing should not produce side effects</li>
     *   <li>Recommended to record processing status to database</li>
     * </ul>
     * 
     * @param event the user created event
     */
    @EventHandler(eventType = "UserCreatedEvent")
    public void onUserCreated(DomainEvent event) {
        // [Idempotency Check] Check if event has been processed
        String eventId = event.getEventId();
        if (isEventProcessed(eventId)) {
            log.info("[<%= displayName %>] Event already processed, skipping: eventId={}", eventId);
            return;
        }

        try {
            // Business processing logic
            log.info("[<%= displayName %>] Received user created event: eventId={}, aggregateId={}", 
                eventId, event.getAggregateId());

            // TODO: Implement specific business logic
            // Example: Create default <%= displayName %> data for new user

            // Mark event as processed
            markEventProcessed(eventId);

            // Record audit log
            runtimeContext.getObservability().log(
                io.runtime.sdk.capability.ObservabilityCapability.LogLevel.INFO,
                "[<%= displayName %>] User created event processing completed: eventId={}", eventId
            );

        } catch (Exception e) {
            // Log error (let Runtime Shell decide whether to retry)
            runtimeContext.getObservability().log(
                io.runtime.sdk.capability.ObservabilityCapability.LogLevel.ERROR,
                "[<%= displayName %>] Event processing failed: eventId={}, error={}", eventId, e.getMessage()
            );
            throw e; // Throw exception to trigger retry mechanism
        }
    }

    /**
     * Check if event has been processed (idempotency)
     * 
     * @param eventId the event ID
     * @return whether the event has been processed
     */
    private boolean isEventProcessed(String eventId) {
        // [Recommended] Use StateStoreCapability to check
        // return runtimeContext.getStateStore()
        //     .exists("event:processed:" + eventId);
        
        // Simple implementation: return false for now
        return false;
    }

    /**
     * Mark event as processed
     * 
     * @param eventId the event ID
     */
    private void markEventProcessed(String eventId) {
        // [Recommended] Use StateStoreCapability to record
        // runtimeContext.getStateStore()
        //     .put("event:processed:" + eventId, true, Duration.ofDays(7));
    }
}
