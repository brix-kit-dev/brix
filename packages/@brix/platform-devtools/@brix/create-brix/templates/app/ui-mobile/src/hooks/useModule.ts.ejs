/**
 * @file <%= displayName %> Hooks（Mobile）
 * @description ViewModel 层 — 业务逻辑和Status管理
 * @module @brix/<%= name %>-ui-mobile
 * @version <%= version %>
 *
 * Generated by @brix/create-brix <%= date %> Auto-generated
 *
 * [Design Notes]
 * 遵循 MVVM 分层架构，Hooks 作为 ViewModel 层：
 * 1. 封装业务逻辑和Status管理
 * 2. Calls Repository 获取数据
 * 3. 向 View 层提供响应式Status和操作方法
 *
 * 【架构红线】
 * - Hooks 不直接访问 HttpCapability，通过 Repository 层
 * - Hooks 不包含 UI 渲染逻辑
 */

import { useState, useEffect, useCallback } from 'react';
import { useRuntimeContext } from '@brix/runtime-sdk-api-mobile';
import type { <%= classPrefix %>, PagedResponse } from '@brix/<%= name %>-shared';
import { create<%= classPrefix %>Repository } from '../repositories/<%= classPrefix %>Repository.js';

// ============================================================================
// 列表 Hook
// ============================================================================

/**
 * <%= displayName %> 列表 Hook BackType
 */
export interface Use<%= classPrefix %>Result {
  /** 数据列表 */
  items: <%= classPrefix %>[];
  /** 是否正在加载 */
  isLoading: boolean;
  /** 是否正在Refresh */
  isRefreshing: boolean;
  /** 错误信息 */
  error: Error | null;
  /** 下拉Refresh */
  onRefresh: () => Promise<void>;
  /** 加载更多 */
  onLoadMore: () => Promise<void>;
  /** 点击项目 */
  onItemPress: (item: <%= classPrefix %>) => void;
}

/**
 * <%= displayName %> 列表 Hook
 *
 * @returns 列表Status和操作方法
 *
 * @example
 * ```tsx
 * const { items, isLoading, onRefresh } = use<%= classPrefix %>();
 * ```
 */
export function use<%= classPrefix %>(): Use<%= classPrefix %>Result {
  const runtimeContext = useRuntimeContext();
  const [items, setItems] = useState<<%= classPrefix %>[]>([]);
  const [page, setPage] = useState(0);
  const [hasMore, setHasMore] = useState(true);
  const [isLoading, setIsLoading] = useState(true);
  const [isRefreshing, setIsRefreshing] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  // 创建 Repository 实例
  const repository = create<%= classPrefix %>Repository(runtimeContext);

  // 加载数据
  const loadData = useCallback(async (pageNum: number, refresh = false) => {
    try {
      if (refresh) {
        setIsRefreshing(true);
      } else {
        setIsLoading(true);
      }
      setError(null);

      const response: PagedResponse<<%= classPrefix %>> = await repository.list({
        page: pageNum,
        size: 20,
      });

      if (refresh) {
        setItems(response.content);
      } else {
        setItems(prev => [...prev, ...response.content]);
      }

      setPage(pageNum);
      setHasMore(!response.last);
    } catch (err) {
      setError(err instanceof Error ? err : new Error(String(err)));
    } finally {
      setIsLoading(false);
      setIsRefreshing(false);
    }
  }, [repository]);

  // 初始加载
  useEffect(() => {
    loadData(0, true);
  }, []);

  // 下拉Refresh
  const onRefresh = useCallback(async () => {
    await loadData(0, true);
  }, [loadData]);

  // 加载更多
  const onLoadMore = useCallback(async () => {
    if (!isLoading && hasMore) {
      await loadData(page + 1);
    }
  }, [isLoading, hasMore, page, loadData]);

  // 点击项目
  const onItemPress = useCallback((item: <%= classPrefix %>) => {
    const navigation = runtimeContext.getCapability('NavigationCapability');
    navigation?.navigate(`/<%= name.replace(/-/g, '/') %>/${item.id}`);
  }, [runtimeContext]);

  return {
    items,
    isLoading,
    isRefreshing,
    error,
    onRefresh,
    onLoadMore,
    onItemPress,
  };
}

// ============================================================================
// 详情 Hook
// ============================================================================

/**
 * <%= displayName %> 详情 Hook BackType
 */
export interface Use<%= classPrefix %>DetailResult {
  /** 详情数据 */
  item: <%= classPrefix %> | null;
  /** 是否正在加载 */
  isLoading: boolean;
  /** 错误信息 */
  error: Error | null;
  /** Refresh */
  refresh: () => Promise<void>;
}

/**
 * <%= displayName %> 详情 Hook
 *
 * @param id 资源 ID
 * @returns 详情Status和操作方法
 */
export function use<%= classPrefix %>Detail(id: string): Use<%= classPrefix %>DetailResult {
  const runtimeContext = useRuntimeContext();
  const [item, setItem] = useState<<%= classPrefix %> | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);

  // 创建 Repository 实例
  const repository = create<%= classPrefix %>Repository(runtimeContext);

  // 加载详情
  const loadDetail = useCallback(async () => {
    try {
      setIsLoading(true);
      setError(null);

      const data = await repository.getById(Number(id));
      setItem(data);
    } catch (err) {
      setError(err instanceof Error ? err : new Error(String(err)));
    } finally {
      setIsLoading(false);
    }
  }, [id, repository]);

  // 初始加载
  useEffect(() => {
    loadDetail();
  }, [id]);

  return {
    item,
    isLoading,
    error,
    refresh: loadDetail,
  };
}
