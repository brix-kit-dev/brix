import type { RuntimeContext, HttpCapability } from '@brix/runtime-sdk-api-mobile';
import type { <%= classPrefix %>, PagedResponse } from '@brix/<%= name %>-shared';
import { API_ENDPOINTS } from '@brix/<%= name %>-shared/constants';

/**
 * <%= displayName %> Repository
 */
export interface <%= classPrefix %>Repository {
  /**
   * 获取分pages列表
   */
  list(params?: { page?: number; size?: number }): Promise<PagedResponse<<%= classPrefix %>>>;

  /**
   * 根据 ID 获取详情
   */
  getById(id: number): Promise<<%= classPrefix %>>;
}

/**
 * 创建 <%= displayName %> Repository 实例
 *
 * @param runtimeContext RuntimeContext 实例
 * @returns Repository 实例
 */
export function create<%= classPrefix %>Repository(runtimeContext: RuntimeContext): <%= classPrefix %>Repository {
  const http = runtimeContext.getCapability<HttpCapability>('HttpCapability');

  if (!http) {
    throw new Error('[<%= name %>-ui-mobile] HttpCapability 不可用');
  }

  return {
    /**
     * 获取分pages列表
     */
    async list(params?: { page?: number; size?: number }): Promise<PagedResponse<<%= classPrefix %>>> {
      const response = await http.request<PagedResponse<<%= classPrefix %>>>({
        url: API_ENDPOINTS.LIST,
        method: 'GET',
        params: {
          page: params?.page ?? 0,
          size: params?.size ?? 20,
        },
      });
      return response.data;
    },

    /**
     * 根据 ID 获取详情
     */
    async getById(id: number): Promise<<%= classPrefix %>> {
      const response = await http.request<<%= classPrefix %>>({
        url: API_ENDPOINTS.DETAIL(id),
        method: 'GET',
      });
      return response.data;
    },
  };
}
