package <%= packageName %>.server.controller;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.Parameter;
import io.swagger.v3.oas.annotations.media.Content;
import io.swagger.v3.oas.annotations.media.Schema;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import io.swagger.v3.oas.annotations.responses.ApiResponses;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import <%= packageName %>.api.dto.<%= classPrefix %>DTO;
import <%= packageName %>.api.request.Create<%= classPrefix %>Request;
import <%= packageName %>.api.request.Update<%= classPrefix %>Request;
import <%= packageName %>.api.service.<%= classPrefix %>Service;

/**
 * <%= displayName %> REST 控制器
 *
 * <p>提供 <%= displayName %> 的 CRUD 操作 REST API。
 * 所有接口均符合 OpenAPI 3.0 规范，可通过 Swagger UI 访问文档。</p>
 *
 * <p>API 路径前缀：{@code /api/v1/<%= name.replace(/-/g, '/') %>}</p>
 *
 * @see <%= classPrefix %>Service 业务逻辑实现
 * @see <%= classPrefix %>DTO 数据传输对象
 */
@Tag(name = "<%= displayName %>", description = "<%= displayName %>管理 API")
@RestController
@RequestMapping("/api/v1/<%= name.replace(/-/g, '/') %>")
public class <%= classPrefix %>Controller {

    private final <%= classPrefix %>Service <%= name.replace(/-./g, c => c.charAt(1).toUpperCase()) %>Service;

    /**
     * 构造函数注入 Service
     *
     * @param service <%= displayName %> 服务
     */
    public <%= classPrefix %>Controller(<%= classPrefix %>Service service) {
        this.<%= name.replace(/-./g, c => c.charAt(1).toUpperCase()) %>Service = service;
    }

    // ========================================================================
    // 查询接口
    // ========================================================================

    /**
     * 分页查询<%= displayName %>列表
     *
     * @param pageable 分页参数（page, size, sort）
     * @return 分页结果
     */
    @Operation(
        summary = "分页查询<%= displayName %>列表",
        description = "支持分页、排序，可通过请求参数过滤"
    )
    @ApiResponses({
        @ApiResponse(
            responseCode = "200",
            description = "查询成功",
            content = @Content(schema = @Schema(implementation = Page.class))
        )
    })
    @GetMapping
    public ResponseEntity<Page<<%= classPrefix %>DTO>> list(
            @Parameter(description = "分页参数") Pageable pageable) {
        Page<<%= classPrefix %>DTO> result = <%= name.replace(/-./g, c => c.charAt(1).toUpperCase()) %>Service.findAll(pageable);
        return ResponseEntity.ok(result);
    }

    /**
     * 根据 ID 查询<%= displayName %>详情
     *
     * @param id 资源 ID
     * @return <%= displayName %>详情
     */
    @Operation(
        summary = "根据 ID 查询<%= displayName %>详情",
        description = "返回指定 ID 的完整信息"
    )
    @ApiResponses({
        @ApiResponse(
            responseCode = "200",
            description = "查询成功",
            content = @Content(schema = @Schema(implementation = <%= classPrefix %>DTO.class))
        ),
        @ApiResponse(
            responseCode = "404",
            description = "资源不存在"
        )
    })
    @GetMapping("/{id}")
    public ResponseEntity<<%= classPrefix %>DTO> getById(
            @Parameter(description = "资源 ID", required = true) @PathVariable Long id) {
        return <%= name.replace(/-./g, c => c.charAt(1).toUpperCase()) %>Service.findById(id)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }

