        description = "删除指定 ID 的<%= displayName %>资源"
    )
    @ApiResponses({
        @ApiResponse(
            responseCode = "204",
            description = "删除成功"
        ),
        @ApiResponse(
            responseCode = "404",
            description = "资源不存在"
        )
    })
    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(
            @Parameter(description = "资源 ID", required = true) @PathVariable Long id) {
        boolean deleted = <%= name.replace(/-./g, c => c.charAt(1).toUpperCase()) %>Service.delete(id);
        return deleted ? ResponseEntity.noContent().build() : ResponseEntity.notFound().build();
    }
}
