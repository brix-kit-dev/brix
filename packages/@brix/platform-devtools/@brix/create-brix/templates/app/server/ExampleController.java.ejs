     */
    @Operation(
        summary = "创建<%= displayName %>",
        description = "创建一个新的<%= displayName %>资源"
    )
    @ApiResponses({
        @ApiResponse(
            responseCode = "201",
            description = "创建成功",
            content = @Content(schema = @Schema(implementation = <%= classPrefix %>DTO.class))
        ),
        @ApiResponse(
            responseCode = "400",
            description = "参数校验失败"
        )
    })
    @PostMapping
    public ResponseEntity<<%= classPrefix %>DTO> create(
            @Valid @RequestBody Create<%= classPrefix %>Request request) {
        <%= classPrefix %>DTO created = <%= name.replace(/-./g, c => c.charAt(1).toUpperCase()) %>Service.create(request);
        return ResponseEntity.status(HttpStatus.CREATED).body(created);
    }

    // ========================================================================
    // 更新接口
    // ========================================================================

    /**
     * 更新<%= displayName %>
     *
     * @param id 资源 ID
     * @param request 更新请求
     * @return 更新后的资源
     */
    @Operation(
        summary = "更新<%= displayName %>",
        description = "更新指定 ID 的<%= displayName %>资源"
    )
    @ApiResponses({
        @ApiResponse(
            responseCode = "200",
            description = "更新成功",
            content = @Content(schema = @Schema(implementation = <%= classPrefix %>DTO.class))
        ),
        @ApiResponse(
            responseCode = "400",
            description = "参数校验失败"
        ),
        @ApiResponse(
            responseCode = "404",
            description = "资源不存在"
        )
    })
    @PutMapping("/{id}")
    public ResponseEntity<<%= classPrefix %>DTO> update(
            @Parameter(description = "资源 ID", required = true) @PathVariable Long id,
            @Valid @RequestBody Update<%= classPrefix %>Request request) {
        return <%= name.replace(/-./g, c => c.charAt(1).toUpperCase()) %>Service.update(id, request)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }

    // ========================================================================
    // 删除接口
    // ========================================================================

    /**
     * 删除<%= displayName %>
     *
