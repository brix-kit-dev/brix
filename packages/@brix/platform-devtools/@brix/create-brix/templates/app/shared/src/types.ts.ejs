/**
 * @file <%= displayName %> Type定义
 * @description 业务Type定义（对应后端 DTO）
 * @module @brix/<%= name %>-shared
 * @version <%= version %>
 *
 * [Design Notes]
 * 本文件定义 <%= displayName %> 的核心业务Type。
 * Type与后端 Java DTO 保持一致，确保前后端Type安全。
 *
 * 【Type来源】
 * 1. 手动定义：常用的核心Type（本文件）
 * 2. Auto-generated：从 OpenAPI 生成的Type（generated/types/）
 *
 * 【使用方式】
 * ```typescript
 * import type { <%= classPrefix %>, <%= classPrefix %>Status } from '@brix/<%= name %>-shared';
 * ```
 */

// ============================================================================
// Status枚举
// ============================================================================

/**
 * <%= displayName %> Status
 */
export type <%= classPrefix %>Status = 
  | 'DRAFT'      // 草稿
  | 'ACTIVE'     // 激活
  | 'INACTIVE'   // 未激活
  | 'DELETED';   // 已Delete

// ============================================================================
// 核心Entity class型
// ============================================================================

/**
 * <%= displayName %> 实体
 *
 * 对应后端 <%= packageName %>.api.dto.<%= classPrefix %>DTO
 */
export interface <%= classPrefix %> {
  /** Unique identifier */
  id: number;
  /** Name */
  name: string;
  /** Description */
  description?: string;
  /** Status */
  status: <%= classPrefix %>Status;
  /** Created at（ISO 8601 格式） */
  createdAt: string;
  /** Updated at（ISO 8601 格式） */
  updatedAt: string;
  /** Created by ID */
  createdBy?: string;
  /** Tenant ID */
  tenantId?: string;
}

// ============================================================================
// 请求/响应Type
// ============================================================================

/**
 * 创建 <%= displayName %> 请求
 *
 * 对应后端 Create<%= classPrefix %>Request
 */
export interface Create<%= classPrefix %>Request {
  /** Name（Required） */
  name: string;
  /** Description */
  description?: string;
}

/**
 * 更新 <%= displayName %> 请求
 *
 * 对应后端 Update<%= classPrefix %>Request
 */
export interface Update<%= classPrefix %>Request {
  /** Name */
  name?: string;
  /** Description */
  description?: string;
  /** Status */
  status?: <%= classPrefix %>Status;
}

/**
 * 分pages响应
 */
export interface PagedResponse<T> {
  /** 数据列表 */
  content: T[];
  /** 总元素数 */
  totalElements: number;
  /** 总pages数 */
  totalPages: number;
  /** 当前pages码（从 0 开始） */
  number: number;
  /** 每pages大小 */
  size: number;
  /** 是否第一pages */
  first: boolean;
  /** 是否最后一pages */
  last: boolean;
}
