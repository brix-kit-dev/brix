/**
 * @file orval Configuration file — <%= displayName %> API TypeAuto-generated
 * @description 从 OpenAPI 规范Auto-generated TypeScript Type和 Repository 客户端
 * @module @brix/<%= name %>-shared
 * @version <%= version %>
 *
 * [Design Notes]
 * 本配置实现 Phase 5.2 前端TypeAuto-generated管线：
 * 1. 从 <%= name %>-api/src/main/resources/openapi.json 读取 OpenAPI 规范
 * 2. 生成 TypeScript Type定义 (types.generated.ts)
 * 3. 生成 Repository 客户端 (<%= classPrefix %>Repository.generated.ts)
 * 4. 使用自定义 HttpCapability 适配器替代 axios/fetch
 *
 * 【工作流程】
 * 后端开发者修改 Controller/DTO
 *   ↓ mvn springdoc-openapi:generate
 * <%= name %>-api/src/main/resources/openapi.json (committed)
 *   ↓ pnpm run generate:api (orval)
 * <%= name %>-shared/src/generated/
 *   ├── types.generated.ts      ← 从 DTO Schema 生成
 *   ├── <%= classPrefix %>Repository.ts    ← 从 API Path 生成（使用 HttpCapability）
 *   └── index.ts                ← 统一Export
 *
 * 【运行命令】
 * pnpm run generate:api
 *
 * 【架构红线 R3 合规】
 * 生成的 Repository 使用 HttpCapability 而非 fetch/axios
 *
 * @see https://orval.dev/reference/configuration/overview
 */

import { defineConfig } from 'orval';

export default defineConfig({
  /**
   * <%= displayName %> API 配置
   */
  <%= name.replace(/-/g, '') %>: {
    /**
     * 输入配置 — OpenAPI 规范文件
     */
    input: {
      /** OpenAPI 规范文件路径（相对于本Configuration file） */
      target: '../<%= name %>-api/src/main/resources/openapi.json',
      /** 输入验证选项 */
      validation: true,
    },

    /**
     * 输出配置 — 生成代码设置
     */
    output: {
      /** 生成模式：tags-split（按 API Tag 分文件） */
      mode: 'tags-split',
      /** Repository 客户端输出目录 */
      target: './src/generated/repositories',
      /** Type定义输出目录 */
      schemas: './src/generated/types',
      /** 客户端Type：react-query 支持 TanStack Query hooks */
      client: 'react-query',
      /** 不生成 Mock 数据 */
      mock: false,

      /**
       * 覆盖配置
       */
      override: {
        /**
         * 自定义 HTTP 客户端 mutator
         *
         * 【架构红线 R3】
         * 使用 HttpCapability 适配器替代Default的 axios/fetch
         * 所有 HTTP 请求必须通过能力契约发起
         */
        mutator: {
          /** 适配器文件路径（相对于输出目录） */
          path: '../http-client.ts',
          /** Export的函数名 */
          name: 'httpCapabilityClient',
        },
        /**
         * React Query 配置
         */
        query: {
          /** 使用 TanStack Query v5 版本 */
          useQuery: true,
          useMutation: true,
          useInfinite: true,
          /** Query 选项 */
          options: {
            /** Default staleTime（5 分钟） */
            staleTime: 5 * 60 * 1000,
          },
        },
      },
    },

    /**
     * 钩子配置 — 生成后处理
     */
    hooks: {
      /** 生成后执行格式化 */
      afterAllFilesWrite: 'prettier --write',
    },
  },
});
