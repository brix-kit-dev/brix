{
  "name": "@brix/<%= name %>-shared",
  "version": "<%= version %>",
  "private": true,
  "description": "<%= displayName %> 多端Total享Type与常量 — v3.0 Manifest-Driven 架构",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.mjs",
      "require": "./dist/events/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.js"
    },
    "./generated": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.mjs",
      "require": "./dist/generated/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate:api": "orval --config orval.config.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pact": "vitest run --config vitest.pact.config.ts",
    "clean": "rimraf dist src/generated pacts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.12.0",
    "eslint": "^9.0.0",
    "orval": "^7.0.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@brix/runtime-sdk-api-web": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.shinwa.io/"
  },
  "author": "<%= author %>",
  "license": "UNLICENSED"
}
