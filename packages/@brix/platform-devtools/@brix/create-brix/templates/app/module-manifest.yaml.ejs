# ================================================================
# v3.0 module声明文件（Module Manifest）
# 
# 这是 v3.0 运行壳架构的核心Configuration file，声明module的：
# - 基本信息（ID、版本、Type）
# - 生命周期（启动顺序、依赖）
# - 能力需求（必需/Optional能力）
# - 事件通信（publish/订阅的事件）
# - 权限声明
# - 配置项
# 
# 【重要】module通过此文件与 Runtime Shell 交互，而非直接依赖基础设施
# 
# @author <%= author %>
# @date <%= date %>
# ================================================================

# ===== module基本信息 =====
module:
  id: "<%= fullName %>"                          # moduleUnique identifier
  version: "<%= version %>"                      # module版本
  type: "<%= moduleType %>"                      # moduleType：business | infrastructure
  description: "<%= description %>"              # moduleDescription

# ===== 生命周期与依赖 =====
lifecycle:
  # 启动优先级（数字越小越先启动，Default 100）
  # - 10: 基础设施module（gateway、identity）
  # - 50: 核心业务module
  # - 100: 普通业务module
  startup-order: <%= startupOrder %>
  
  # 依赖的module（必须先于本module启动）
  depends-on:
<% if (dependsOn.length === 0) { -%>
    []
<% } else { -%>
<% dependsOn.forEach(dep => { -%>
    - "<%= dep %>"
<% }); -%>
<% } -%>

# ===== 能力需求声明 =====
capabilities:
  # 必需能力（缺失则启动失败）
  required:
<% if (requiredCapabilities.length === 0) { -%>
    []
<% } else { -%>
<% requiredCapabilities.forEach(cap => { -%>
    - "<%= cap %>"
<% }); -%>
<% } -%>
  
  # Optional能力（缺失则降级运行）
  optional:
<% if (optionalCapabilities.length === 0) { -%>
    []
<% } else { -%>
<% optionalCapabilities.forEach(cap => { -%>
    - "<%= cap %>"
<% }); -%>
<% } -%>

# ===== 事件通信声明 =====
events:
  # publish的事件（module产生的领域事件/集成事件）
  publishes:
<% if (publishesEvents.length === 0) { -%>
    # 示例：预约Created Event
    # - type: "<%= classPrefix %>CreatedEvent"
    #   category: "domain"                       # domain | integration
    #   description: "<%= displayName %>Created Event"
    []
<% } else { -%>
<% publishesEvents.forEach(event => { -%>
    - type: "<%= event %>"
      category: "domain"
<% }); -%>
<% } -%>
  
  # 订阅的事件（module关心的外部事件）
  subscribes:
<% if (subscribesEvents.length === 0) { -%>
    # 示例：用户Created Event
    # - type: "UserCreatedEvent"
    #   handler: "<%= classPrefix %>EventHandler.onUserCreated"
    []
<% } else { -%>
<% subscribesEvents.forEach(event => { -%>
    - type: "<%= event %>"
<% }); -%>
<% } -%>

# ===== 权限声明 =====
permissions:
  # module定义的权限点
  - id: "<%= name %>:read"
    name: "View<%= displayName %>"
    description: "允许View<%= displayName %>数据"
  - id: "<%= name %>:write"
    name: "Edit<%= displayName %>"
    description: "允许创建、修改、Delete<%= displayName %>数据"

# ===== 配置项声明 =====
config:
  # module需要的配置项（由 Host 提供）
  - key: "<%= name %>.enabled"
    type: "boolean"
    default: true
    description: "是否Enabled<%= displayName %>module"
  # - key: "<%= name %>.max-items"
  #   type: "integer"
  #   default: 100
  #   description: "maximumitems目数"

# ===== 容错配置 =====
resilience:
  # 熔断器配置
  circuit-breaker:
    enabled: true
    failure-rate-threshold: 50          # 失败率阈值（%）
    slow-call-rate-threshold: 100       # 慢Calls率阈值（%）
    slow-call-duration-threshold: "5s"  # 慢Calls判定时间
    wait-duration-in-open-state: "30s"  # 熔断等待时间
  
  # 限流配置
  rate-limiter:
    enabled: false
    # limit-for-period: 100             # 周期内请求限制
    # limit-refresh-period: "1s"        # 限制Refresh周期
