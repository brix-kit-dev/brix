<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.app</groupId>
        <artifactId><%= fullName || name %></artifactId>
        <version><%= version %></version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId><%= name %>-app</artifactId>
    <packaging>jar</packaging>

    <name><%= displayName %> App</name>
    <description><%= displayName %> standalone launcher</description>

    <dependencies>
        <dependency>
            <groupId>io.brix.app</groupId>
            <artifactId><%= name %>-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix.app</groupId>
            <artifactId><%= name %>-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix.app</groupId>
            <artifactId><%= name %>-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
<% if (features.database) { -%>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
<% } -%>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass><%= packageName %>.app.<%= classPrefix %>Application</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>