package <%= packageName %>.server.controller;

import <%= packageName %>.api.dto.<%= classPrefix %>DTO;
import <%= packageName %>.api.request.Create<%= classPrefix %>Request;
import <%= packageName %>.core.service.<%= classPrefix %>Service;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import java.util.List;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/<%= name %>")
@Tag(name = "<%= displayName %>")
public class <%= classPrefix %>Controller {

    private final <%= classPrefix %>Service service;

    public <%= classPrefix %>Controller(<%= classPrefix %>Service service) {
        this.service = service;
    }

    @GetMapping
    @Operation(summary = "List <%= displayName %> records")
    public List<<%= classPrefix %>DTO> list() {
        return service.listCurrentTenant();
    }

    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    @Operation(summary = "Create a <%= displayName %> record")
    public <%= classPrefix %>DTO create(@Valid @RequestBody Create<%= classPrefix %>Request request) {
        return service.create(request);
    }
}