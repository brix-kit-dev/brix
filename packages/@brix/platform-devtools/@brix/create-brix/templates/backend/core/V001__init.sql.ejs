-- =========================================================
-- <%= displayName %> initial schema
-- Version: V<%= typeof flywayPrefix !== 'undefined' ? flywayPrefix : '001' %>_001
-- Generated at: <%= date %>
-- =========================================================

CREATE TABLE IF NOT EXISTS <%= name.replace('plugin-', '').replace(/-/g, '_') %>_record (
    id              BIGSERIAL PRIMARY KEY,
    tenant_id       VARCHAR(64) NOT NULL,
    name            VARCHAR(255) NOT NULL,
    description     TEXT,
    status          VARCHAR(32) NOT NULL DEFAULT 'ACTIVE',
    created_at      TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by      VARCHAR(64),
    updated_at      TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_by      VARCHAR(64),
    version         INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_<%= name.replace('plugin-', '').replace(/-/g, '_') %>_record_tenant 
    ON <%= name.replace('plugin-', '').replace(/-/g, '_') %>_record(tenant_id);

<% if (typeof includeOutbox !== 'undefined' && includeOutbox) { %>
-- =========================================================
-- Outbox table for integration event consistency
-- =========================================================
CREATE TABLE IF NOT EXISTS <%= name.replace('plugin-', '').replace(/-/g, '_') %>_outbox (
    id              BIGSERIAL PRIMARY KEY,
    tenant_id       VARCHAR(64) NOT NULL,
    aggregate_type  VARCHAR(255) NOT NULL,
    aggregate_id    VARCHAR(255) NOT NULL,
    event_type      VARCHAR(255) NOT NULL,
    payload         JSONB NOT NULL,
    created_at      TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    processed_at    TIMESTAMP,
    retry_count     INTEGER NOT NULL DEFAULT 0,
    status          VARCHAR(32) NOT NULL DEFAULT 'PENDING'
);

CREATE INDEX IF NOT EXISTS idx_<%= name.replace('plugin-', '').replace(/-/g, '_') %>_outbox_status 
    ON <%= name.replace('plugin-', '').replace(/-/g, '_') %>_outbox(status, created_at);
<% } %>

COMMENT ON TABLE <%= name.replace('plugin-', '').replace(/-/g, '_') %>_record IS '<%= displayName %> records';
