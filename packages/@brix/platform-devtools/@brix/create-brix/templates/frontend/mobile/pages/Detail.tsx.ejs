 * <%= displayName %> Mobile - Detail Page
 * 
 * @module @brix/<%= name %>-mobile
 * @generated <%= date %>
 * 
 * Detail page implementation (called by exposes wrapper)
 */

import React, { useCallback, useEffect, useState } from 'react';
import {
  View,
  Text,
  ScrollView,
  StyleSheet,
  ActivityIndicator,
  TouchableOpacity,
  Alert,
} from 'react-native';

/**
 * Detail data interface
 */
export interface DetailData {
  id: number;
  title: string;
  description?: string;
  createdAt?: string;
  updatedAt?: string;
  status?: string;
  [key: string]: unknown;
}

/**
 * Detail page props
 */
export interface <%= classPrefix %>DetailPageProps {
  /**
   * Data ID
   */
  id: number;
  
  /**
   * Back callback
   */
  onBack?: () => void;
  
  /**
   * Edit callback
   */
  onEdit?: (data: DetailData) => void;
  
  /**
   * API base path
   */
  apiBasePath?: string;
}

/**
 * <%= displayName %> Detail Page Component
 */
const <%= classPrefix %>DetailPage: React.FC<<%= classPrefix %>DetailPageProps> = ({
  id,
  onBack,
  onEdit,
  apiBasePath = '/api/v1/<%= name.replace('plugin-', '') %>',
}) => {
  const [data, setData] = useState<DetailData | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  /**
   * Load detail data
   */
  const loadData = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);

      // TODO: Replace with actual API call
      // const response = await fetch(`${apiBasePath}/${id}`);
      // const result = await response.json();
      
      await new Promise(resolve => setTimeout(resolve, 800));
      setData({
        id,
        title: `Item ${id}`,
        description: 'This is a detailed description text for demonstrating the detail page layout. It can contain multiple lines of text.',
        createdAt: new Date(Date.now() - 86400000 * 7).toISOString(),
        updatedAt: new Date().toISOString(),
        status: 'active',
      });
    } catch (err) {
      setError('Failed to load details, please retry');
      console.error('Failed to load details:', err);
    } finally {
      setLoading(false);
    }
  }, [id, apiBasePath]);

  useEffect(() => {
    loadData();
  }, [loadData]);

  /**
   * Handle delete
   */
  const handleDelete = useCallback(() => {
    Alert.alert(
      'Confirm Delete',
      'Are you sure you want to delete this item? This action cannot be undone.',
      [
        { text: 'Cancel', style: 'cancel' },
        {
          text: 'Delete',
          style: 'destructive',
          onPress: async () => {
            try {
              // TODO: Call delete API
              // await fetch(`${apiBasePath}/${id}`, { method: 'DELETE' });
              Alert.alert('Notice', 'Deleted successfully');
              onBack?.();
            } catch (err) {
              Alert.alert('Error', 'Failed to delete, please retry');
            }
          },
        },
      ]
    );
  }, [id, apiBasePath, onBack]);

  /**
   * Render status badge
   */
  const renderStatus = (status: string) => {
    const statusConfig: Record<string, { label: string; color: string; bgColor: string }> = {
      active: { label: 'Active', color: '#2e7d32', bgColor: '#e8f5e9' },
      inactive: { label: 'Inactive', color: '#c62828', bgColor: '#ffebee' },
      pending: { label: 'Pending', color: '#ef6c00', bgColor: '#fff3e0' },
    };
    
    const config = statusConfig[status] || statusConfig.pending;
    
    return (
      <View style={[styles.statusBadge, { backgroundColor: config.bgColor }]}>
        <Text style={[styles.statusText, { color: config.color }]}>{config.label}</Text>
      </View>
    );
  };

  if (loading) {
    return (
      <View style={[styles.container, styles.center]}>
        <ActivityIndicator size="large" color="#1976d2" />
        <Text style={styles.loadingText}>Loading...</Text>
      </View>
    );
  }

  if (error) {
    return (
      <View style={[styles.container, styles.center]}>
        <Text style={styles.errorText}>{error}</Text>
        <TouchableOpacity style={styles.retryButton} onPress={loadData}>
          <Text style={styles.retryText}>Retry</Text>
        </TouchableOpacity>
      </View>
    );
  }

  if (!data) {
    return (
      <View style={[styles.container, styles.center]}>
        <Text style={styles.emptyText}>Data not found</Text>
        {onBack && (
          <TouchableOpacity style={styles.backButton} onPress={onBack}>
            <Text style={styles.backButtonText}>Back</Text>
          </TouchableOpacity>
        )}
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <ScrollView style={styles.scrollView}>
        {/* 标题区域 */}
        <View style={styles.header}>
          <Text style={styles.title}>{data.title}</Text>
          {data.status && renderStatus(data.status)}
        </View>

        {/* 详情内容 */}
        <View style={styles.content}>
          {data.description && (
            <View style={styles.section}>
              <Text style={styles.sectionTitle}>Description</Text>
              <Text style={styles.sectionContent}>{data.description}</Text>
            </View>
          )}

          <View style={styles.divider} />

          <View style={styles.infoGrid}>
            {data.createdAt && (
              <View style={styles.infoItem}>
                <Text style={styles.infoLabel}>Created at</Text>
                <Text style={styles.infoValue}>
                  {new Date(data.createdAt).toLocaleString('zh-CN')}
                </Text>
              </View>
            )}
            {data.updatedAt && (
              <View style={styles.infoItem}>
                <Text style={styles.infoLabel}>Updated at</Text>
                <Text style={styles.infoValue}>
                  {new Date(data.updatedAt).toLocaleString('zh-CN')}
                </Text>
              </View>
            )}
          </View>
        </View>
      </ScrollView>

      {/* 底部操作栏 */}
      <View style={styles.bottomBar}>
        {onBack && (
          <TouchableOpacity style={styles.secondaryButton} onPress={onBack}>
            <Text style={styles.secondaryButtonText}>Back</Text>
          </TouchableOpacity>
        )}
        {onEdit && (
          <TouchableOpacity 
            style={styles.primaryButton} 
            onPress={() => onEdit(data)}
          >
            <Text style={styles.primaryButtonText}>Edit</Text>
          </TouchableOpacity>
        )}
        <TouchableOpacity style={styles.dangerButton} onPress={handleDelete}>
          <Text style={styles.dangerButtonText}>Delete</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
};

