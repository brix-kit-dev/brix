/**
 * Internationalization Configuration
 * 
 * @module @brix/<%= name %>-web
 * @generated <%= date %>
 * 
 * Usage:
 * 1. Add translation files for each language in the locales directory
 * 2. Use useTranslation hook in components to get the t function
 * 3. Call addPluginTranslations() to add translation resources to host i18n instance
 */

import i18n from 'i18next';

const zhCN = {
  '<%= name.replace('plugin-', '') %>': {
    list: {
      title: '<%= displayName %>列表',
      searchPlaceholder: 'Search<%= displayName %>...',
      add: '新增<%= displayName %>',
      name: 'Name',
      createdAt: 'Created at',
    },
    detail: {
      title: '<%= displayName %>详情',
      basicInfo: '基本信息',
      id: 'ID',
      name: 'Name',
      description: 'Description',
      status: 'Status',
      createdAt: 'Created at',
      updatedAt: 'Updated at',
    },
  },
};

const enUS = {
  '<%= name.replace('plugin-', '') %>': {
    list: {
      title: '<%= displayName %> List',
      searchPlaceholder: 'Search <%= displayName %>...',
      add: 'Add <%= displayName %>',
      name: 'Name',
      createdAt: 'Created At',
    },
    detail: {
      title: '<%= displayName %> Detail',
      basicInfo: 'Basic Information',
      id: 'ID',
      name: 'Name',
      description: 'Description',
      status: 'Status',
      createdAt: 'Created At',
      updatedAt: 'Updated At',
    },
  },
};

let translationsAdded = false;

export function addPluginTranslations(): void {
  if (translationsAdded) {
    return;
  }

  if (!i18n.isInitialized) {
    console.warn('[<%= name %>-web] i18n not initialized yet, translations will be added later');
    return;
  }

  i18n.addResourceBundle('zh-CN', 'translation', zhCN, true, true);
  i18n.addResourceBundle('zh', 'translation', zhCN, true, true);
  
  i18n.addResourceBundle('en-US', 'translation', enUS, true, true);
  i18n.addResourceBundle('en', 'translation', enUS, true, true);

  translationsAdded = true;
  console.debug('[<%= name %>-web] Plugin translations added to i18n instance');
}

export default { zhCN, enUS };
