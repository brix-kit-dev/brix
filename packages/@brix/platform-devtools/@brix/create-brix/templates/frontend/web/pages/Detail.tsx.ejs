import React from 'react';
import { useUI } from '@brix-sdk/runtime-sdk-react';

export default function <%= classPrefix %>Detail(): React.ReactElement {
  const { Box, Typography, Paper } = useUI();

  return (
    <Box data-module="<%= name %>" sx={{ p: 3 }}>
      <Paper sx={{ p: 3 }}>
        <Typography variant="h5"><%= displayName %></Typography>
        <Typography variant="body2" color="text.secondary">Detail view</Typography>
      </Paper>
    </Box>
  );
}
