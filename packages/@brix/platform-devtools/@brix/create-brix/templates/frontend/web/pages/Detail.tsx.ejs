/**
 * <%= classPrefix %> Detail Page
 * 
 * @module @brix/<%= name %>-web
 * @generated <%= date %>
 * 
 * Features:
 * - Display <%= displayName %> detail information
 * - Support edit and return to list
 */

import React, { useEffect, useState, useCallback } from 'react';
import {
  Box,
  Typography,
  Paper,
  CircularProgress,
  Alert,
  Stack,
  Button,
  Divider,
  Grid,
  Chip,
} from '@mui/material';
import {
  ArrowBack,
  Edit,
  Delete,
} from '@mui/icons-material';
import { useNavigate, useParams } from 'react-router-dom';
import { useTranslation } from 'react-i18next';

/**
 * Detail Field Component
 */
interface DetailFieldProps {
  label: string;
  value: React.ReactNode;
}

const DetailField: React.FC<DetailFieldProps> = ({ label, value }) => (
  <Box sx={{ mb: 2 }}>
    <Typography variant="caption" color="text.secondary" sx={{ display: 'block', mb: 0.5 }}>
      {label}
    </Typography>
    <Typography variant="body1">{value || '-'}</Typography>
  </Box>
);

/**
 * <%= displayName %> Detail Page Component
 */
export default function <%= classPrefix %>Detail(): React.ReactElement {
  const navigate = useNavigate();
  const { t } = useTranslation();
  const { id } = useParams<{ id: string }>();
  
  // State management
  const [data, setData] = useState<any | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Load detail data
  const fetchDetail = useCallback(async () => {
    if (!id) return;
    
    setLoading(true);
    setError(null);
    try {
      // TODO: Replace with actual API call
      // const response = await api.get<%= classPrefix %>Detail(id);
      // setData(response.data);
      
      // Mock data
      await new Promise(resolve => setTimeout(resolve, 500));
      setData({
        id,
        name: '<%= displayName %> Sample',
        description: 'This is a sample description',
        status: 'ACTIVE',
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
      });
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to load details');
    } finally {
      setLoading(false);
    }
  }, [id]);

  // Initial load
  useEffect(() => {
    fetchDetail();
  }, [fetchDetail]);

  // Return to list
  const handleBack = () => {
    navigate('/<%= name.replace('plugin-', '') %>');
  };

  // Edit
  const handleEdit = () => {
    navigate(`/<%= name.replace('plugin-', '') %>/${id}/edit`);
  };

  // Delete confirmation
  const handleDelete = async () => {
    if (!window.confirm(t('common.deleteConfirm', '确定要Delete吗？'))) {
      return;
    }
    
    try {
      // TODO: Replace with actual API call
      // await api.delete<%= classPrefix %>(id);
      navigate('/<%= name.replace('plugin-', '') %>');
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to delete');
    }
  };

  // Loading state
  if (loading) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', minHeight: 400 }}>
        <CircularProgress />
      </Box>
    );
  }

  // Error state
  if (error) {
    return (
      <Box sx={{ p: 3 }}>
        <Alert severity="error" action={
          <Button color="inherit" size="small" onClick={fetchDetail}>
            {t('common.retry', '重试')}
          </Button>
        }>
          {error}
        </Alert>
      </Box>
    );
  }

  // Data not found
  if (!data) {
    return (
      <Box sx={{ p: 3 }}>
        <Alert severity="warning">
          {t('common.notFound', '数据不存在')}
        </Alert>
      </Box>
    );
  }

  return (
    <Box sx={{ p: 3 }}>
      {/* Page title and action bar */}
      <Stack direction="row" alignItems="center" justifyContent="space-between" sx={{ mb: 3 }}>
        <Stack direction="row" alignItems="center" spacing={2}>
          <Button startIcon={<ArrowBack />} onClick={handleBack}>
            {t('common.back', 'Back')}
          </Button>
          <Typography variant="h5" component="h1">
            {t('<%= name.replace('plugin-', '') %>.detail.title', '<%= displayName %>详情')}
          </Typography>
        </Stack>
        <Stack direction="row" spacing={1}>
          <Button variant="outlined" startIcon={<Edit />} onClick={handleEdit}>
            {t('common.edit', 'Edit')}
          </Button>
          <Button variant="outlined" color="error" startIcon={<Delete />} onClick={handleDelete}>
            {t('common.delete', 'Delete')}
          </Button>
        </Stack>
      </Stack>

      {/* 详情内容 */}
      <Paper sx={{ p: 3 }}>
        <Typography variant="h6" gutterBottom>
          {t('<%= name.replace('plugin-', '') %>.detail.basicInfo', '基本信息')}
        </Typography>
        <Divider sx={{ mb: 2 }} />
        
        <Grid container spacing={3}>
          <Grid item xs={12} md={6}>
            <DetailField 
              label={t('<%= name.replace('plugin-', '') %>.detail.id', 'ID')} 
              value={data.id} 
            />
          </Grid>
          <Grid item xs={12} md={6}>
            <DetailField 
              label={t('<%= name.replace('plugin-', '') %>.detail.name', 'Name')} 
              value={data.name} 
            />
          </Grid>
          <Grid item xs={12} md={6}>
            <DetailField 
              label={t('<%= name.replace('plugin-', '') %>.detail.status', 'Status')} 
              value={
                <Chip 
                  label={data.status} 
                  color={data.status === 'ACTIVE' ? 'success' : 'default'}
                  size="small"
                />
              } 
            />
          </Grid>
          <Grid item xs={12}>
            <DetailField 
              label={t('<%= name.replace('plugin-', '') %>.detail.description', 'Description')} 
              value={data.description} 
            />
          </Grid>
          <Grid item xs={12} md={6}>
            <DetailField 
              label={t('<%= name.replace('plugin-', '') %>.detail.createdAt', 'Created at')} 
              value={new Date(data.createdAt).toLocaleString()} 
            />
          </Grid>
          <Grid item xs={12} md={6}>
            <DetailField 
              label={t('<%= name.replace('plugin-', '') %>.detail.updatedAt', 'Updated at')} 
              value={new Date(data.updatedAt).toLocaleString()} 
            />
          </Grid>
        </Grid>
      </Paper>
    </Box>
  );
}
