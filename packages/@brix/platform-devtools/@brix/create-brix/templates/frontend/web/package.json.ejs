{
  "name": "<%= npmPackageName || '@brix-sdk/' + name + '-ui-web' %>",
  "version": "<%= sdkVersion %>",
  "private": true,
  "description": "<%= displayName %> Web frontend",
  "type": "module",
  "scripts": {
    "start": "rspack serve",
    "dev": "rspack serve",
    "build": "rspack build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:ci": "eslint src --ext .ts,.tsx --max-warnings 0",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "^23.16.8"<% if (typeof withShared !== 'undefined' && withShared) { %>,
    "@brix-sdk/<%= name %>-shared": "workspace:*"<% } %>
  },
  "peerDependencies": {
    "@brix-sdk/shared-runtime-web": "^<%= sdkVersion %>",
    "@brix-sdk/runtime-sdk-api-web": "^<%= sdkVersion %>",
    "@brix-sdk/runtime-sdk-react": "^<%= sdkVersion %>",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@brix-sdk/eslint-config-architecture": "^<%= sdkVersion %>",
    "@brix-sdk/shared-runtime-web": "^<%= sdkVersion %>",
    "@brix-sdk/runtime-sdk-api-web": "^<%= sdkVersion %>",
    "@brix-sdk/runtime-sdk-react": "^<%= sdkVersion %>",
    "@rspack/cli": "^1.6.8",
    "@rspack/core": "^1.6.8",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "eslint": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.2"
  }
}
