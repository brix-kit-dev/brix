import { defineConfig } from '@rspack/cli';
import { ModuleFederationPlugin } from '@module-federation/enhanced/rspack';
import path from 'path';

const isDev = process.env.NODE_ENV !== 'production';
const PORT = process.env.PORT || <%= webPort || 3000 %>;

// Module Federation 的 scope 名称（驼峰命名）
const SCOPE_NAME = '<%= name.replace('plugin-', '').replace(/-./g, x => x[1].toUpperCase()) %>';

export default defineConfig({
  entry: './src/index.tsx',
  output: {
    path: path.resolve(__dirname, 'dist'),
    publicPath: isDev ? `http://localhost:${PORT}/` : '/',
    filename: '[name].[contenthash].js',
    uniqueName: '<%= name %>-web',
  },
  resolve: {
    extensions: ['.tsx', '.ts', '.jsx', '.js', '.json'],
    alias: {
      '@': path.resolve(__dirname, 'src'),
    },
  },
  module: {
    rules: [
      {
        test: /\.(ts|tsx)$/,
        exclude: /node_modules/,
        use: {
          loader: 'builtin:swc-loader',
          options: {
            jsc: {
              parser: {
                syntax: 'typescript',
                tsx: true,
              },
              transform: {
                react: {
                  runtime: 'automatic',
                },
              },
            },
          },
        },
      },
      {
        test: /\.css$/,
        type: 'css',
      },
      {
        test: /\.(png|jpg|jpeg|gif|svg|woff|woff2|eot|ttf|otf)$/,
        type: 'asset',
      },
    ],
  },
  plugins: [
    new ModuleFederationPlugin({
      name: SCOPE_NAME,
      filename: 'remoteEntry.js',
      exposes: {
        // 暴露列表页面
        './<%= classPrefix %>List': './src/exposes/<%= classPrefix %>List.tsx',
        // 暴露详情页面
        './<%= classPrefix %>Detail': './src/exposes/<%= classPrefix %>Detail.tsx',
      },
      shared: {
        react: {
          singleton: true,
          requiredVersion: '^18.3.1',
          eager: false,
        },
        'react-dom': {
          singleton: true,
          requiredVersion: '^18.3.1',
          eager: false,
        },
        'react-router-dom': {
          singleton: true,
          requiredVersion: '^6.28.0',
          eager: false,
        },
        '@mui/material': {
          singleton: true,
          requiredVersion: '^5.16.14',
          eager: false,
        },
        '@emotion/react': {
          singleton: true,
          requiredVersion: '^11.14.0',
          eager: false,
        },
        '@emotion/styled': {
          singleton: true,
          requiredVersion: '^11.14.0',
          eager: false,
        },
        i18next: {
          singleton: true,
          requiredVersion: '^23.16.8',
          eager: false,
        },
        'react-i18next': {
          singleton: true,
          requiredVersion: '^15.1.3',
          eager: false,
        },
      },
    }),
  ],
  devServer: {
    port: PORT,
    hot: true,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, PATCH, OPTIONS',
      'Access-Control-Allow-Headers': '*',
    },
    historyApiFallback: true,
    allowedHosts: 'all',
  },
  optimization: {
    splitChunks: false, // Module Federation 需要禁用 splitChunks
  },
});
