import React from 'react';
import { useUI } from '@brix-sdk/runtime-sdk-react';
<% if (typeof withShared !== 'undefined') { -%>
import { use<%= classPrefix %> } from '../hooks/use<%= classPrefix %>';
<% } -%>

export default function <%= classPrefix %>List(): React.ReactElement {
  const { Box, Typography, Paper, Button, Stack, Spin, Alert } = useUI();
<% if (typeof withShared !== 'undefined') { -%>
  const { records, isLoading, error, reload } = use<%= classPrefix %>();

  if (isLoading) {
    return <Spin />;
  }

  return (
    <Box data-module="<%= name %>" sx={{ p: 3 }}>
      <Stack direction="row" justifyContent="space-between" alignItems="center" sx={{ mb: 2 }}>
        <Typography variant="h5"><%= displayName %></Typography>
        <Button variant="outlined" onClick={reload}>Refresh</Button>
      </Stack>
      {error ? <Alert severity="error">{error.message}</Alert> : null}
      <Stack spacing={2}>
        {records.map(record => (
          <Paper key={record.id} sx={{ p: 2 }}>
            <Typography variant="subtitle1">{record.name}</Typography>
            <Typography variant="body2" color="text.secondary">{record.createdAt}</Typography>
          </Paper>
        ))}
      </Stack>
    </Box>
  );
<% } else { -%>
  return (
    <Box data-module="<%= name %>" sx={{ p: 3 }}>
      <Paper sx={{ p: 3 }}>
        <Typography variant="h5"><%= displayName %></Typography>
        <Typography variant="body2" color="text.secondary"><%= description %></Typography>
      </Paper>
    </Box>
  );
<% } -%>
}
