/**
 * <%= classPrefix %> 列表页面
 * 
 * @module @shinwa/<%= name %>-web
 * @generated <%= date %>
 * 
 * 功能说明：
 * - 展示 <%= displayName %> 数据列表
 * - 支持分页和搜索
 * - 支持查看详情、编辑、删除操作
 */

import React, { useEffect, useState, useCallback } from 'react';
import {
  Box,
  Typography,
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TablePagination,
  CircularProgress,
  Alert,
  Stack,
  Button,
  TextField,
  InputAdornment,
  IconButton,
  Paper,
  Tooltip,
} from '@mui/material';
import {
  Search,
  Refresh,
  Add,
  Edit,
  Delete,
  Visibility,
} from '@mui/icons-material';
import { useNavigate } from 'react-router-dom';
import { useTranslation } from 'react-i18next';

/**
 * <%= displayName %> 列表页面组件
 */
export default function <%= classPrefix %>List(): React.ReactElement {
  const navigate = useNavigate();
  const { t } = useTranslation();
  
  // 状态管理
  const [data, setData] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [keyword, setKeyword] = useState('');
  const [pagination, setPagination] = useState({
    page: 0,
    size: 10,
    totalElements: 0,
    totalPages: 0,
  });

  // 加载数据
  const fetchData = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      // TODO: 替换为实际的 API 调用
      // const response = await api.get<%= classPrefix %>List({ keyword, page: pagination.page, size: pagination.size });
      // setData(response.data.content);
      // setPagination(prev => ({ ...prev, totalElements: response.data.totalElements, totalPages: response.data.totalPages }));
      
      // 模拟数据
      await new Promise(resolve => setTimeout(resolve, 500));
      setData([
        { id: '1', name: '<%= displayName %> 示例 1', createdAt: new Date().toISOString() },
        { id: '2', name: '<%= displayName %> 示例 2', createdAt: new Date().toISOString() },
      ]);
      setPagination(prev => ({ ...prev, totalElements: 2, totalPages: 1 }));
    } catch (err) {
      setError(err instanceof Error ? err.message : '加载数据失败');
    } finally {
      setLoading(false);
    }
  }, [keyword, pagination.page, pagination.size]);

  // 首次加载
  useEffect(() => {
    fetchData();
  }, [fetchData]);

  // 搜索处理
  const handleSearch = useCallback(() => {
    setPagination(prev => ({ ...prev, page: 0 }));
    fetchData();
  }, [fetchData]);

  // 刷新处理
  const handleRefresh = useCallback(() => {
    setKeyword('');
    setPagination(prev => ({ ...prev, page: 0 }));
    fetchData();
  }, [fetchData]);

  // 分页处理
  const handleChangePage = (_: unknown, newPage: number) => {
    setPagination(prev => ({ ...prev, page: newPage }));
  };

  const handleChangeRowsPerPage = (event: React.ChangeEvent<HTMLInputElement>) => {
    setPagination(prev => ({ ...prev, page: 0, size: parseInt(event.target.value, 10) }));
  };

  // 查看详情
  const handleView = (id: string) => {
    navigate(`/<%= name.replace('plugin-', '') %>/${id}`);
  };

  return (
    <Box sx={{ p: 3 }}>
      {/* 页面标题 */}
      <Typography variant="h5" component="h1" gutterBottom>
        {t('<%= name.replace('plugin-', '') %>.list.title', '<%= displayName %>列表')}
      </Typography>

      {/* 工具栏 */}
      <Paper sx={{ p: 2, mb: 2 }}>
        <Stack direction="row" spacing={2} alignItems="center">
          <TextField
            size="small"
            placeholder={t('<%= name.replace('plugin-', '') %>.list.searchPlaceholder', '搜索...')}
            value={keyword}
            onChange={(e) => setKeyword(e.target.value)}
            onKeyPress={(e) => e.key === 'Enter' && handleSearch()}
            InputProps={{
              startAdornment: (
                <InputAdornment position="start">
                  <Search />
                </InputAdornment>
              ),
            }}
            sx={{ minWidth: 250 }}
          />
          <Button variant="outlined" onClick={handleSearch} startIcon={<Search />}>
            {t('common.search', '搜索')}
          </Button>
          <Button variant="outlined" onClick={handleRefresh} startIcon={<Refresh />}>
            {t('common.refresh', '刷新')}
          </Button>
          <Box sx={{ flexGrow: 1 }} />
          <Button variant="contained" startIcon={<Add />} onClick={() => navigate('/<%= name.replace('plugin-', '') %>/new')}>
            {t('<%= name.replace('plugin-', '') %>.list.add', '新增')}
          </Button>
        </Stack>
      </Paper>

      {/* 错误提示 */}
      {error && (
        <Alert severity="error" sx={{ mb: 2 }}>
          {error}
        </Alert>
      )}

      {/* 数据表格 */}
      <Paper>
        {loading ? (
          <Box sx={{ display: 'flex', justifyContent: 'center', p: 4 }}>
            <CircularProgress />
          </Box>
        ) : (
          <>
            <Table>
              <TableHead>
                <TableRow>
                  <TableCell>ID</TableCell>
                  <TableCell>{t('<%= name.replace('plugin-', '') %>.list.name', '名称')}</TableCell>
                  <TableCell>{t('<%= name.replace('plugin-', '') %>.list.createdAt', '创建时间')}</TableCell>
                  <TableCell align="right">{t('common.actions', '操作')}</TableCell>
                </TableRow>
              </TableHead>
              <TableBody>
                {data.map((item) => (
                  <TableRow key={item.id} hover>
                    <TableCell>{item.id}</TableCell>
                    <TableCell>{item.name}</TableCell>
                    <TableCell>{new Date(item.createdAt).toLocaleString()}</TableCell>
                    <TableCell align="right">
                      <Tooltip title={t('common.view', '查看')}>
                        <IconButton size="small" onClick={() => handleView(item.id)}>
                          <Visibility />
                        </IconButton>
                      </Tooltip>
                      <Tooltip title={t('common.edit', '编辑')}>
                        <IconButton size="small" onClick={() => navigate(`/<%= name.replace('plugin-', '') %>/${item.id}/edit`)}>
                          <Edit />
                        </IconButton>
                      </Tooltip>
                      <Tooltip title={t('common.delete', '删除')}>
                        <IconButton size="small" color="error">
                          <Delete />
                        </IconButton>
                      </Tooltip>
                    </TableCell>
                  </TableRow>
                ))}
                {data.length === 0 && (
                  <TableRow>
                    <TableCell colSpan={4} align="center" sx={{ py: 4 }}>
                      <Typography color="text.secondary">
                        {t('common.noData', '暂无数据')}
                      </Typography>
                    </TableCell>
                  </TableRow>
                )}
              </TableBody>
            </Table>
            <TablePagination
              component="div"
              count={pagination.totalElements}
              page={pagination.page}
              rowsPerPage={pagination.size}
              onPageChange={handleChangePage}
              onRowsPerPageChange={handleChangeRowsPerPage}
              rowsPerPageOptions={[10, 20, 50]}
              labelRowsPerPage={t('common.rowsPerPage', '每页行数')}
            />
          </>
        )}
      </Paper>
    </Box>
  );
}
