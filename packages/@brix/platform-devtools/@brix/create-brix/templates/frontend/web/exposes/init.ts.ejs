/**
 * 插件初始化module
 * 
 * 该module确保在任何暴露的组件被加载时，插件的翻译资源已添加到基座的 i18n 实例
 * 
 * @module @brix/<%= name %>-web
 * @generated <%= date %>
 * 
 * 使用方式：在每个 exposes 包装器文件中Import此module
 * 
 * @example
 * ```tsx
 * import './init'; // 确保翻译资源已加载
 * export { default } from '../pages/<%= classPrefix %>List';
 * ```
 */

import { addPluginTranslations } from '../i18n';

// 立即执行初始化
addPluginTranslations();

// Export空对象，便于Confirmmodule已加载
export const initialized = true;
