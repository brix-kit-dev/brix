<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.brix.app</groupId>
    <artifactId><%= moduleId %></artifactId>
    <version><%= version %></version>
  </parent>
  <artifactId><%= moduleId %>-api</artifactId>
  <packaging>jar</packaging>
  <!-- The plugin's contracts live here. ContractSourcesTest pins every schema version this module ships in
       src/main/brix/contracts.api, so a published version cannot change. See the Queries guide in the Brix
       documentation. -->
  <dependencies>
    <dependency>
      <groupId>io.brix</groupId>
      <artifactId>runtime-contract-generator</artifactId>
      <version><%= runtimeVersion %></version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.0.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
