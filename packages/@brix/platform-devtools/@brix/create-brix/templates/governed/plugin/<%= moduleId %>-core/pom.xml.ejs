    <dependency>
      <groupId>io.brix.app</groupId>
      <artifactId><%= moduleId %>-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.brix</groupId>
      <artifactId>runtime-sdk-api</artifactId>
      <version><%= runtimeVersion %></version>
    </dependency>
  </dependencies>
</project>
