apiVersion: brix.io/v1
kind: Plugin
metadata:
  pluginId: <%= moduleId %>
  name: <%= moduleId %>
  version: <%= version %>
  displayName: <%= displayName %>
  vendor: <%= vendor %>
  license: <%= license %>
  attestationIdentity: brix://attestations/<%= moduleId %>
runtime:
  compiledAgainst: <%= runtimeVersion %>
  supportedRange: "<%= runtimeRange %>"
modules:
  - groupId: io.brix.app
    artifactId: <%= moduleId %>-api
    version: <%= version %>
    moduleKind: plugin-api
  - groupId: io.brix.app
    artifactId: <%= moduleId %>-core
    version: <%= version %>
    moduleKind: plugin-core
  - groupId: io.brix.app
    artifactId: <%= moduleId %>-server
    version: <%= version %>
    moduleKind: plugin-server
endpoints:
  provides: []
capabilities:
  required: []
  optional: []
# Typed queries: a provided query's contract and generated types go in <%= moduleId %>-api, and a caller requires
# io.runtime.sdk.capability.QueryCapability. See the Queries guide in the Brix documentation.
queries:
  provides: []
  consumes: []
# Typed commands: a provided command's contract and generated types go in <%= moduleId %>-api, and its provider declares
# data.inbox; a sender requires io.runtime.sdk.capability.CommandCapability and declares data.outbox. See the Events
# and Commands guide in the Brix documentation.
commands:
  provides: []
  consumes: []
events:
  publishes: []
  subscribes: []
tasks:
  provides: []
internalContracts:
  provides: []
externalServices: []
data:
  storageId: <%= storageId %>
  migrationLocation: db/migration/<%= moduleId %>
permissions:
  - id: <%= permissionId %>
    description: Read <%= displayName %> resources.
config: []
ui:
  web:
    enabled: false
