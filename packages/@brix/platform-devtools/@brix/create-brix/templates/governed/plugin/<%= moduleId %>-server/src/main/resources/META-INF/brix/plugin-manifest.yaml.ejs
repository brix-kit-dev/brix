apiVersion: brix.io/v1
kind: Plugin
metadata:
  pluginId: <%= moduleId %>
  name: <%= moduleId %>
  version: <%= version %>
  displayName: <%= displayName %>
  vendor: <%= vendor %>
  license: <%= license %>
  attestationIdentity: brix://attestations/<%= moduleId %>
runtime:
  compiledAgainst: <%= runtimeVersion %>
  supportedRange: "<%= runtimeRange %>"
modules:
  - groupId: io.brix.app
    artifactId: <%= moduleId %>-api
    version: <%= version %>
    moduleKind: plugin-api
  - groupId: io.brix.app
    artifactId: <%= moduleId %>-core
    version: <%= version %>
    moduleKind: plugin-core
  - groupId: io.brix.app
    artifactId: <%= moduleId %>-server
    version: <%= version %>
    moduleKind: plugin-server
endpoints:
  provides: []
capabilities:
  required: []
  optional: []
queries:
  provides: []
  consumes: []
commands:
  provides: []
  consumes: []
events:
  publishes: []
  subscribes: []
tasks:
  provides: []
internalContracts:
  provides: []
externalServices: []
data:
  storageId: <%= storageId %>
  migrationLocation: db/migration/<%= moduleId %>
permissions:
  - id: <%= permissionId %>
    description: Read <%= displayName %> resources.
config: []
ui:
  web:
    enabled: false
