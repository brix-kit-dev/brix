{
  "name": "@brix-sdk/create-brix",
  "version": "3.2.0",
  "description": "Brix Platform CLI - Create plugins and services",
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "create-brix": "./dist/cli.js",
    "brix": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test:phase7": "node scripts/phase7-smoke.mjs",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ejs": "^3.1.9",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "validate-npm-package-name": "^5.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "brix",
    "platform",
    "cli",
    "scaffold",
    "plugin",
    "service",
    "generator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-platform/platform-devtools.git",
    "directory": "@brix-sdk/create-brix"
  },
  "publishConfig": {
    "access": "public"
  }
}
