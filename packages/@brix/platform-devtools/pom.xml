<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        platform-devtools 聚合 POM
        
        作用：统一管理开发者工具集的 Java 模块构建。
        当前仅聚合 architecture-guard（ArchUnit 共享规则库），
        后续可扩展更多开发工具模块。
        
        层级归属：开源层 (io.brix)
        品牌分层：@brix/* — Developer Experience Platform
    -->

    <groupId>io.brix</groupId>
    <artifactId>platform-devtools</artifactId>
    <version>3.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Brix Platform DevTools</name>
    <description>
        Brix 平台开发者工具集 — 架构红线守护、脚手架、设计令牌。
        开发者工具与脚手架同仓，确保"生成即合规"。
    </description>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!-- 聚合子模块 -->
    <modules>
        <module>architecture-guard</module>
    </modules>
</project>
