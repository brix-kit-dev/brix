{
  "name": "platform-devtools",
  "version": "3.2.0",
  "description": "Brix Platform DevTools - Development-time tooling only",
  "private": true,
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "clean": "pnpm -r clean",
    "lint": "pnpm -r lint",
    "publish:all": "pnpm -r publish --access public",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && pnpm changeset:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@changesets/changelog-github": "^0.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "brix",
    "platform",
    "devtools",
    "cli",
    "scaffold"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-platform/platform-devtools.git"
  }
}
