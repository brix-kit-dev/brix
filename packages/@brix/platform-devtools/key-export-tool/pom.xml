<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        key-export-tool
        
        Standalone CLI utility to export RSA keys from a PKCS#12 keystore to
        PEM format. Used during deployment key provisioning, not a runtime
        dependency. Migrated from enterprise host shell standalone
        (Phase 3.9, Architecture Review M9).

        Layer: Open Source Layer (io.brix.devtools)
    -->

    <parent>
        <groupId>io.brix</groupId>
        <artifactId>platform-devtools</artifactId>
        <version>3.2.0</version>
    </parent>

    <artifactId>key-export-tool</artifactId>
    <version>3.2.0</version>
    <packaging>jar</packaging>

    <name>Brix Key Export Tool</name>
    <description>
        CLI tool to export RSA public/private keys from PKCS#12 keystores to PEM files.
        Intended for deployment-time key provisioning, not runtime use.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!-- No external dependencies — uses only java.base and java.security -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.brix.devtools.keys.ExportKeys</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
