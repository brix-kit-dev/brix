{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brix.io/schemas/plugin-manifest.schema.json",
  "title": "Brix v3.0.10 Plugin Manifest",
  "description": "Strict schema for the active YAML plugin manifest at META-INF/brix/plugin-manifest.yaml. YAML is the declarative source of truth; Java SPI implementations must not duplicate manifest metadata.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "runtime", "modules", "capabilities", "queries", "commands", "events"],
  "properties": {
    "apiVersion": {
      "const": "brix.io/v1"
    },
    "kind": {
      "const": "Plugin"
    },
    "metadata": {
      "$ref": "#/definitions/metadata"
    },
    "runtime": {
      "$ref": "#/definitions/runtime"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/module"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/route"
      },
      "default": []
    },
    "capabilities": {
      "$ref": "#/definitions/capabilitySection"
    },
    "queries": {
      "$ref": "#/definitions/contractSection"
    },
    "commands": {
      "$ref": "#/definitions/contractSection"
    },
    "events": {
      "$ref": "#/definitions/eventSection"
    },
    "externalServices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/externalService"
      },
      "default": []
    },
    "data": {
      "$ref": "#/definitions/dataSection"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/permission"
      },
      "default": []
    },
    "config": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/configEntry"
      },
      "default": []
    },
    "ui": {
      "$ref": "#/definitions/uiSection"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "metadata": {
      "type": "object",
      "required": ["pluginId", "name", "version", "vendor", "license"],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/definitions/semver"
        },
        "displayName": {
          "type": "string"
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attestationIdentity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["compiledAgainst", "supportedRange"],
      "properties": {
        "compiledAgainst": {
          "$ref": "#/definitions/semver"
        },
        "supportedRange": {
          "$ref": "#/definitions/range"
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": ["groupId", "artifactId", "version", "moduleKind"],
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/definitions/semver"
        },
        "moduleKind": {
          "type": "string",
          "enum": ["plugin-api", "plugin-core", "plugin-server", "shared-contract", "ui-web", "ui-mobile", "platform-capability", "runtime-capability", "adapter", "host"]
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["id", "path", "method"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "handler": {
          "type": "string"
        },
        "accessPolicy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capabilitySection": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capabilityRef"
          },
          "default": []
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capabilityRef"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "capabilityRef": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/definitions/range"
        }
      },
      "additionalProperties": false
    },
    "contractSection": {
      "type": "object",
      "required": ["provides", "consumes"],
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contractRef"
          },
          "default": []
        },
        "consumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contractRef"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "eventSection": {
      "type": "object",
      "required": ["publishes", "subscribes"],
      "properties": {
        "publishes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contractRef"
          },
          "default": []
        },
        "subscribes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contractRef"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "contractRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string"
        },
        "version": {
          "$ref": "#/definitions/semver"
        },
        "handler": {
          "type": "string"
        },
        "availability": {
          "type": "string",
          "enum": ["required", "optional"]
        },
        "idempotency": {
          "type": "string"
        },
        "authorization": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "externalService": {
      "type": "object",
      "required": ["id", "baseUrlRef"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "baseUrlRef": {
          "type": "string",
          "minLength": 1
        },
        "authPolicyRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dataSection": {
      "type": "object",
      "required": ["storageId"],
      "properties": {
        "storageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,30}$"
        },
        "schema": {
          "type": "string"
        },
        "migrationLocation": {
          "type": "string"
        },
        "outbox": {
          "type": "string"
        },
        "inbox": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "configEntry": {
      "type": "object",
      "required": ["key", "type", "sensitivity"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "boolean", "decimal", "duration", "uri"]
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "secret", "pii", "financial", "health"]
        }
      },
      "additionalProperties": false,
      "not": {
        "properties": {
          "sensitivity": {
            "const": "secret"
          }
        },
        "required": ["sensitivity", "default"]
      }
    },
    "uiSection": {
      "type": "object",
      "properties": {
        "web": {
          "$ref": "#/definitions/uiPlatform"
        },
        "mobile": {
          "$ref": "#/definitions/uiPlatform"
        }
      },
      "additionalProperties": false
    },
    "uiPlatform": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "manifestUrl": {
          "type": "string",
          "pattern": "^/"
        },
        "runtimeRange": {
          "$ref": "#/definitions/range"
        }
      },
      "additionalProperties": false
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?(?:\\+[0-9A-Za-z][0-9A-Za-z.-]*)?$"
    },
    "range": {
      "type": "string",
      "pattern": "^(?:(?:>=|>|<=|<|=)?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?)(?:\\s+(?:>=|>|<=|<|=)?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?)*$"
    }
  }
}
