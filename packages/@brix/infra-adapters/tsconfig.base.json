{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Base Configuration */
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    
    /* Strict Mode */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    
    /* Output Configuration */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    
    /* JSX */
    "jsx": "react-jsx",
    
    /* Path Mapping - Frontend Adapters */
    "baseUrl": ".",
    "paths": {
      /* Web Adapters */
      "@brix/infra-adapter-http-web": ["./packages/web/infra-adapter-http-web/src"],
      "@brix/infra-adapter-mf-web": ["./packages/web/infra-adapter-mf-web/src"],
      "@brix/infra-adapter-iframe-web": ["./packages/web/infra-adapter-iframe-web/src"],
      "@brix/infra-adapter-native-web": ["./packages/web/infra-adapter-native-web/src"],
      "@brix/infra-adapter-ui-native": ["./packages/web/infra-adapter-ui-native/src"],
      "@brix/infra-adapter-router-web": ["./packages/web/infra-adapter-router-web/src"],
      "@brix/infra-adapter-state-web": ["./packages/web/infra-adapter-state-web/src"],
      /* Mobile Adapters */
      "@brix/infra-adapter-module-mobile": ["./packages/mobile/infra-adapter-module-mobile/src"],
      "@brix/infra-adapter-navigation-mobile": ["./packages/mobile/infra-adapter-navigation-mobile/src"],
      "@brix/infra-adapter-storage-mobile": ["./packages/mobile/infra-adapter-storage-mobile/src"],
      "@brix/infra-adapter-device-mobile": ["./packages/mobile/infra-adapter-device-mobile/src"],
      "@brix/infra-adapter-push-mobile": ["./packages/mobile/infra-adapter-push-mobile/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
