{
  "name": "@brix/infra-adapter-ui-native",
  "version": "3.1.0",
  "type": "module",
  "description": "Brix Native UI Adapter - Pure CSS atomic components implementing UIAdapter contract without third-party UI library dependencies",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@brix/runtime-sdk-api-web": "link:../../../../runtime-sdk/runtime-sdk-api-web",
    "@brix/design-tokens": "link:../../../../platform-devtools/@brix/design-tokens"
  },
  "peerDependencies": {
    "@brix/runtime-sdk-api-web": "^3.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "keywords": [
    "brix",
    "infra-adapter",
    "ui",
    "native",
    "css",
    "atomic-components",
    "uiadapter"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-framework/infra-adapters",
    "directory": "packages/web/infra-adapter-ui-native"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "rimraf": "^5.0.0"
  }
}
