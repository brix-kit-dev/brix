<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix</groupId>
        <artifactId>infra-adapters</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../../pom.xml</relativePath>
    </parent>

    <artifactId>infra-adapter-kafka-outbox</artifactId>
    <packaging>jar</packaging>

    <name>Brix Infra Adapter - Kafka Outbox</name>
    <description>
        Outbox Pattern Event Publishing Adapter (Open Source)
        
        Provides a transactional event publishing mechanism based on the Outbox pattern,
        guaranteeing data consistency between business operations and event publishing
        (at-least-once semantics).
        
        Core Components:
        - OutboxEvent: Outbox event JPA entity
        - OutboxEventPublisher: Scheduled publisher (processOutbox / retryFailedEvents / cleanupOldEvents)
        - OutboxEventRepository: Spring Data JPA repository
        - OutboxAutoConfiguration: Spring Boot auto-configuration
        
        Design Notes:
        Outbox is a cross-infrastructure pattern (requires DB + MQ coordination);
        it is isolated into its own module to avoid infra-adapter-kafka pulling in JPA
        dependencies. This module is an optional enhancement for infra-adapter-kafka,
        requiring both the Kafka adapter and JPA dependencies to activate.
        
        Naming Convention:
        - Maven GroupId: io.brix (brand)
        - Java Package: io.infra.adapter.outbox (neutral)
        
        Architecture Layer: Layer 2.5 - Adapter Layer (Open Source)
    </description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <dependencies>
        <!-- ========== Brix Runtime SDK API (Open Source Core Layer) ========== -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- ========== Depends on Kafka Core (sub-module dependency within the same aggregator) ========== -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-kafka-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ========== Spring Boot ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========== Database (core dependency for Outbox pattern) ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ========== Kafka (event sending) ========== -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ========== JSON Serialization ========== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- ========== Logging ========== -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ========== AOP (for @CriticalEvent Outbox interception, R13.4) ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ========== Micrometer (optional, for Outbox metrics: R3.7) ========== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========== Tests ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
