<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix</groupId>
        <artifactId>infra-adapters</artifactId>
        <version>3.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>infra-adapter-fallback</artifactId>
    <packaging>jar</packaging>

    <name>Brix Fallback Capability Adapter</name>
    <description>
        Brix Fallback 能力适配器 - 提供最小化的默认能力实现
        
        【用途】
        当没有其他具体适配器提供能力实现时，使用此模块作为 fallback：
        - AuthContextCapability: 匿名访问，允许所有权限
        - ObservabilityCapability: 基于 SLF4J 的日志实现
        - ConfigStoreCapability: 基于环境变量和系统属性
        - LifecycleCapability: 空操作实现
        - ResilienceCapability: 透传式实现，无真实弹性保护
        
        【架构说明】
        此模块属于 Layer 2.5 - 适配器层，遵循架构蓝图设计：
        - Host 层（shinwa-host-assembly）只做组装，不含实现代码
        - 默认能力实现必须在此模块，由 Host 层引用
        
        【使用方式】
        Host 层通过 @ConditionalOnMissingBean 方式引入默认实现：
        &lt;dependency&gt;
            &lt;groupId&gt;io.brix&lt;/groupId&gt;
            &lt;artifactId&gt;infra-adapter-fallback&lt;/artifactId&gt;
            &lt;scope&gt;runtime&lt;/scope&gt;
        &lt;/dependency&gt;
    </description>

    <dependencies>
        <!-- Brix Runtime SDK API -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Spring Boot Auto Configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
