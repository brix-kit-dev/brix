<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix</groupId>
        <artifactId>infra-adapters</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>infra-adapter-fallback</artifactId>
    <packaging>jar</packaging>

    <name>Brix Fallback Capability Adapter</name>
    <description>
        Brix Fallback Capability Adapter - Provides minimal default capability implementations
        
        [Purpose]
        When no other concrete adapter provides a capability implementation,
        this module serves as the fallback:
        - AuthContextCapability: Anonymous access, allows all permissions
        - ObservabilityCapability: SLF4J-based logging implementation
        - ConfigStoreCapability: Based on environment variables and system properties
        - LifecycleCapability: No-op implementation
        - ResilienceCapability: Pass-through implementation, no real resilience protection
        
        [Architecture]
        This module belongs to Layer 2.5 - Adapter Layer, following the architecture blueprint:
        - Host layer (brix-host-assembly) only performs assembly, contains no implementation code
        - Default capability implementations reside in this module, referenced by the Host layer
        
        [Usage]
        Host layer includes default implementations via @ConditionalOnMissingBean:
        &lt;dependency&gt;
            &lt;groupId&gt;io.brix&lt;/groupId&gt;
            &lt;artifactId&gt;infra-adapter-fallback&lt;/artifactId&gt;
            &lt;scope&gt;runtime&lt;/scope&gt;
        &lt;/dependency&gt;
    </description>

    <dependencies>
        <!-- Brix Runtime SDK API -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Spring Boot Auto Configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
