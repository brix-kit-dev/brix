<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix</groupId>
        <artifactId>infra-adapters</artifactId>
        <version>3.2.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>infra-adapter-webhook</artifactId>
    <name>Brix Infra Adapter - Webhook</name>
    <description>
        HTTP Webhook-based EventBus Adapter Implementation (Open Source)
        
        Provides lightweight event publishing capability for Embedded Host mode:
        - HttpWebhookEventBus: Publishes events via HTTP POST
        - WebhookSignatureVerifier: Webhook signature verification
        - WebhookRetryHandler: Exponential backoff retry
        
        Use Cases:
        - Embedded mode deployment (no Kafka)
        - Webhook integration with external systems
        - Lightweight event notification
        
        Architecture Layer: Layer 2 - Adapter Layer
        Package: io.infra.adapter.webhook
        License: Apache 2.0
    </description>

    <dependencies>
        <!-- Runtime SDK API -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- JSON Serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- HTTP Client -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Spring Boot (optional, for auto-configuration) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Micrometer Core for event metrics (R3.3 compliance, optional) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
