<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.brix</groupId>
    <artifactId>infra-adapters</artifactId>
    <version>3.2.0</version>
    <packaging>pom</packaging>

    <name>Brix Infrastructure Adapters</name>
    <description>
        Brix Infrastructure Adapters (Open Source)
        
        Provides various infrastructure implementations for runtime-sdk capability interfaces,
        organized by target platform:
        - server/  Backend Java adapters
          - infra-adapter-kafka: Kafka EventBus implementation
          - infra-adapter-redis: Redis StateStore / distributed lock implementation
          - infra-adapter-outbox: Outbox transactional event publishing
          - infra-adapter-database: Database capability implementation
          - infra-adapter-minio: Object storage capability implementation
          - infra-adapter-otel: OpenTelemetry observability implementation
          - infra-adapter-simple: Lightweight in-memory implementation
          - infra-adapter-webhook: HTTP Webhook implementation
          - infra-adapter-fallback: Minimal fallback default implementation
        - web/     Frontend Web TypeScript adapters
        - mobile/  Frontend Mobile TypeScript adapters
        
        Architecture Layer: Layer 2.5 - Adapter Layer
        License: Apache 2.0
    </description>

    <url>https://github.com/brix-framework/infra-adapters</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/brix-framework/infra-adapters.git</connection>
        <developerConnection>scm:git:ssh://github.com:brix-framework/infra-adapters.git</developerConnection>
        <url>https://github.com/brix-framework/infra-adapters</url>
    </scm>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        
        <!-- Brix Version -->
        <runtime-sdk.version>3.2.0</runtime-sdk.version>
        
        <!-- Spring Boot — aligned with brix root POM -->
        <spring-boot.version>4.0.6</spring-boot.version>
        
        <!-- Other Dependency Versions -->
        <jackson.version>2.16.1</jackson.version>
        <slf4j.version>2.0.9</slf4j.version>
        <flyway.version>11.8.0</flyway.version>
    </properties>

    <modules>
        <!-- ========== Backend Adapters (Java / Spring Boot) ========== -->
        <module>packages/server/infra-adapter-kafka</module>
        <module>packages/server/infra-adapter-redis</module>
        <module>packages/server/infra-adapter-database</module>
        <module>packages/server/infra-adapter-minio</module>
        <module>packages/server/infra-adapter-simple</module>
        <module>packages/server/infra-adapter-webhook</module>
        <module>packages/server/infra-adapter-otel</module>
        <module>packages/server/infra-adapter-fallback</module>
        <module>packages/server/infra-adapter-idgen</module>
        <module>packages/server/infra-adapter-dataaccess</module>
        <module>packages/server/infra-adapter-config</module>
        <module>packages/server/infra-adapter-resilience</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            
            <!-- Brix Runtime SDK -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>runtime-sdk-api</artifactId>
                <version>${runtime-sdk.version}</version>
            </dependency>
            
            <!-- Infra Adapter - Kafka Core (dependency for Outbox module) -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>infra-adapter-kafka-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <!-- Infra Adapter - Kafka Outbox -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>infra-adapter-kafka-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <!-- Infra Adapter - Fallback (dependency for Simple module) -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>infra-adapter-fallback</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Infra Adapter - Config (Spring Environment-backed ConfigStoreCapability) -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>infra-adapter-config</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Infra Adapter - Resilience (Resilience4j-backed ResilienceCapability) -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>infra-adapter-resilience</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Flyway (override older version in Spring Boot BOM) -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.12.1</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                    <configuration>
                        <doclint>none</doclint>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
