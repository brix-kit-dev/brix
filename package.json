{
  "name": "@brix/monorepo",
  "version": "3.2.0",
  "private": true,
  "description": "Brix Runtime Shell Framework - Open Source Monorepo",
  "keywords": [
    "brix",
    "runtime-shell",
    "capability-contract",
    "plugin-architecture",
    "modular-framework"
  ],
  "author": "Brix Platform Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brix-kit-dev/brix"
  },
  "homepage": "https://github.com/brix-kit-dev/brix",
  "scripts": {
    "build": "pnpm --filter \"@brix/runtime-sdk-*\" run build && pnpm -r run build",
    "build:all": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "lint": "node scripts/check-banned-tokens.mjs && pnpm -r run lint",
    "lint:banned-tokens": "node scripts/check-banned-tokens.mjs",
    "architecture:validate": "python3 scripts/validate_architecture_context.py --canonical-root ../brix-enterprise",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "typecheck": "pnpm -r run typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && pnpm changeset:publish",
    "docs": "typedoc",
    "docs:typedoc": "typedoc --options typedoc.json",
    "docs:javadoc": "mvn javadoc:aggregate -DskipTests",
    "docs:all": "pnpm docs:typedoc && pnpm docs:javadoc",
    "prepare": "echo 'Brix workspace ready'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@changesets/changelog-github": "^0.5.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "typedoc": "^0.28.19",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "brace-expansion@<1.1.14": "1.1.14",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=4.0.0 <4.0.1": "4.0.1",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "esbuild": "0.28.0",
      "fast-xml-parser": "4.5.5",
      "flatted": "3.4.2",
      "handlebars": "4.7.9",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.15",
      "undici": "7.25.0",
      "ws": "8.21.0",
      "yaml": "2.9.0"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
